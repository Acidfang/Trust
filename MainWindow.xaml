<Window x:Class="Trust.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trust"
        mc:Ignorable="d"
        Title="Invariant Identity Engine - Control Panel" Height="600" Width="900"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Invariant Identity Engine v2"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#4EC9B0"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="ToggleOverlayButton"
                    Content="Show Overlay"
                    Click="ToggleOverlayButton_Click"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button x:Name="ToggleInterceptButton"
                    Content="Start Intercept (F9)"
                    Click="ToggleInterceptButton_Click"
                    Width="150"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#4EC9B0"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button x:Name="TestButton"
                    Content="Run Test"
                    Click="TestButton_Click"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#CE9178"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button x:Name="ValidateButton"
                    Content="Validate Spec"
                    Click="ValidateButton_Click"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#569CD6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button x:Name="ClearButton"
                    Content="Clear Log"
                    Click="ClearButton_Click"
                    Width="100"
                    Height="35"
                    Background="#D16969"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <Border Grid.Row="2" 
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputTextBox"
                         Text="Invariant Identity Engine initialized.&#x0a;Press 'Show Overlay' to activate click-through overlay.&#x0a;Press F9 or 'Start Intercept' to begin interception mode.&#x0a;&#x0a;"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         Foreground="#D4D4D4"
                         BorderThickness="0"
                         Padding="10"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
            <TextBlock x:Name="StatusLabel"
                       Text="Status: Ready"
                       Foreground="#4EC9B0"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <TextBlock x:Name="BrickCountLabel"
                       Text="Bricks: 0"
                       Foreground="#DCDCAA"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <TextBlock x:Name="CompressionLabel"
                       Text="Compression: 0%"
                       Foreground="#CE9178"
                       FontSize="14"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
