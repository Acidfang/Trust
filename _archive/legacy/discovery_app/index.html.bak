            { id: 'MASS', name: 'Mass', desc: 'Quantity of matter', formula: 'm', type: 'Physics', domain: 'Interaction' },
            { id: 'FORCE', name: 'Force', desc: 'Push or pull interaction', formula: 'F=ma', type: 'Physics', domain: 'Interaction' },
            { id: 'KINETIC_ENERGY', name: 'Kinetic Energy', desc: 'Motion energy measure', formula: 'K=½mv²', type: 'Physics', domain: 'Interaction' },
            { id: 'POTENTIAL_ENERGY', name: 'Potential Energy', desc: 'Stored capacity from position', formula: 'U', type: 'Physics', domain: 'Interaction' },
            { id: 'PHOTON', name: 'Photon', desc: 'Light quantum particle', formula: 'E=hf', type: 'Physics', domain: 'Interaction' },
            { id: 'FEEDBACK', name: 'Feedback', desc: 'Output influences input', type: 'Control', domain: 'Interaction' },
            { id: 'POSITIVE_FEEDBACK', name: 'Positive Feedback', desc: 'Amplifying feedback loop', type: 'Control', domain: 'Interaction' },
            { id: 'NEGATIVE_FEEDBACK', name: 'Negative Feedback', desc: 'Stabilizing feedback loop', type: 'Control', domain: 'Interaction' }
          ],
          
          // BRIDGE: Compositions linking domains
          compositions: [
            { id: 'MOLECULE', name: 'Molecule', desc: 'Bonded atoms structure', type: 'Bridge', domain: 'Composition' },
            { id: 'CELL', name: 'Cell', desc: 'Basic life unit with organelles', type: 'Bridge', domain: 'Composition' },
            { id: 'DNA', name: 'DNA', desc: 'Genetic code material', type: 'Bridge', domain: 'Composition' },
            { id: 'PROTEIN', name: 'Protein', desc: 'Amino acid polymer', type: 'Bridge', domain: 'Composition' },
            { id: 'METABOLISM', name: 'Metabolism', desc: 'Chemical reactions in organism', type: 'Bridge', domain: 'Composition' },
            { id: 'ORGANISM', name: 'Organism', desc: 'Living system entity', type: 'Bridge', domain: 'Composition' },
            { id: 'REPRODUCTION', name: 'Reproduction', desc: 'Creating new individuals', type: 'Bridge', domain: 'Composition' },
            { id: 'EVOLUTION', name: 'Evolution', desc: 'Inherited change over time', type: 'Bridge', domain: 'Composition' },
            { id: 'ECOSYSTEM', name: 'Ecosystem', desc: 'Community and environment', type: 'Bridge', domain: 'Composition' },
            { id: 'HOMEOSTASIS', name: 'Homeostasis', desc: 'Stability self-regulation', type: 'Bridge', domain: 'Composition' }
          ]
        }
        return ufmLibrary
      }
      
      
      handleSearch(e) {
        const query = e.target.value.toLowerCase()
        this.renderPrimitiveList(query)
      }
      
      renderPrimitiveList(filter = '') {
        const list = document.getElementById('primitive-list')
        list.innerHTML = ''
        
        const allPrimitives = []
        for (const [container, primitives] of Object.entries(this.primitiveDatabase)) {
          primitives.forEach(p => {
            allPrimitives.push({ ...p, container })
          })
        }
        
        const filtered = allPrimitives.filter(p => 
          p.name.toLowerCase().includes(filter) || 
          p.type.toLowerCase().includes(filter) ||
          p.desc.toLowerCase().includes(filter)
        )
        
        const colors = { boolean: '#FF00FF', topological: '#00D9FF', probability: '#FFFF00', interaction: '#00FF00' }
        
        filtered.forEach(prim => {
          const li = document.createElement('li')
          li.className = 'primitive-item'
          li.innerHTML = `
            <div class="primitive-name">${prim.name}</div>
            <div class="primitive-type" style="color: ${colors[prim.container]}">${prim.type}</div>
          `
          li.onclick = () => this.selectPrimitiveFromList(prim)
          if (this.selectedParticle?.primitive?.name === prim.name) {
            li.classList.add('selected')
          }
          list.appendChild(li)
        })
      }
      
      selectPrimitiveFromList(primitive) {
        const matching = this.particles.find(p => p.primitive.name === primitive.name)
        if (matching) {
          this.selectedParticle = matching
          this.showDetailPanel(matching)
          this.renderPrimitiveList()
        }
      }
      
      setDomain(domain, buttonElement) {
        // Map domain to container for now
        const domainToContainer = {
          'binary': 'boolean',
          'atomics': 'topological',
          'chemistry': 'probability',
          'physics': 'interaction',
          'biology': 'compositions',
          'ecology': 'compositions'
        }
        
        const container = domainToContainer[domain] || 'boolean'
        this.currentDomain = domain
        
        // Update active domain button styling
        document.querySelectorAll('.domain-btn').forEach(btn => btn.classList.remove('active'))
        if (buttonElement) {
          buttonElement.classList.add('active')
        }
        
        // Set the mapped container
        this.setContainer(container)
      }
      
      setContainer(name) {
        document.getElementById('detail-panel').classList.remove('visible')
        this.selectedParticle = null
        this.currentContainer = name
        
        const CONTAINERS = {
          boolean: 16, 
          topological: 64, 
          probability: 40, 
          interaction: 50, 
          compositions: 10
        }
        const count = CONTAINERS[name] || 16
        const primitives = this.primitiveDatabase[name] || []
        
        this.particles = []
        for (let i = 0; i < count; i++) {
          const angle = (i / count) * Math.PI * 2
          const r = 100 + Math.random() * 50
          const p = new Particle(Math.cos(angle) * r, Math.sin(angle) * r, Math.random() * 50 - 25)
          p.radius = 3 + Math.random() * 3
          
          // Use primitive from database if available
          if (primitives[i]) {
            p.primitive = { ...primitives[i], container: name }
          } else {
            p.primitive = { 
              id: `P${i}`,
              name: `${name} Primitive ${i}`, 
              desc: 'Undocumented primitive',
              container: name,
              type: 'Other'
            }
          }
          
          this.particles.push(p)
        }
        this.edges = []
        
        // Update UI
        document.querySelectorAll('.container-btn').forEach((btn, idx) => {
          const containers = ['boolean', 'topological', 'probability', 'interaction', 'compositions']
          btn.classList.toggle('active', containers[idx] === name)
        })
        
        document.getElementById('primitive-search').value = ''
        this.renderPrimitiveList()
        this.updateSidebarStats()
      }
      
      updateSidebarStats() {
        const stats = document.getElementById('sidebar-stats')
        const total = Object.values(this.primitiveDatabase).reduce((sum, arr) => sum + arr.length, 0)
        const isComposition = this.currentContainer === 'compositions'
        stats.innerHTML = `
          Total: ${total}<br>
          Current: ${this.particles.length}<br>
          Active: ${this.physicsEnabled ? 'On' : 'Off'}<br>
          ${isComposition ? '<br>🧬 Inter-Species<br>Breeding View' : ''}
        `
      }
      
      updatePhysics() {
        if (!this.physicsEnabled) return
        const K_REPEL = 50, K_DAMPING = 0.95
        
        // Apply repulsive forces
        for (let i = 0; i < this.particles.length; i++) {
          for (let j = i + 1; j < this.particles.length; j++) {
            const p1 = this.particles[i], p2 = this.particles[j]
            const dx = p2.x - p1.x, dy = p2.y - p1.y
            const dist = Math.sqrt(dx*dx + dy*dy) + 0.1
            const f = K_REPEL / (dist * dist)
            const nx = dx / dist, ny = dy / dist
            p1.vx -= nx * f; p1.vy -= ny * f
            p2.vx += nx * f; p2.vy += ny * f
          }
        }
        
        // Apply damping and gravity towards center
        const centerX = this.canvas.width / 2 / this.zoom - this.panX / this.zoom
        const centerY = this.canvas.height / 2 / this.zoom - this.panY / this.zoom
        const gravity = 0.05
        
        this.particles.forEach(p => {
          p.vx *= K_DAMPING
          p.vy *= K_DAMPING
          const dx = centerX - p.x, dy = centerY - p.y
          p.vx += dx * gravity * 0.0001
          p.vy += dy * gravity * 0.0001
          p.x += p.vx
          p.y += p.vy
        })
      }
      
      render() {
        const colors = { boolean: '#FF00FF', topological: '#00D9FF', probability: '#FFFF00', interaction: '#00FF00', compositions: '#00DD88' }
        
        // Handle glow render mode
        if (this.renderMode === 'glow') {
          this.renderCoherenceGlow()
          return
        }
        
        // Clear canvas
        this.ctx.fillStyle = 'rgba(10, 10, 10, 1)'
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height)
        
        // Apply transform
        this.ctx.save()
        this.ctx.translate(this.panX, this.panY)
        this.ctx.scale(this.zoom, this.zoom)
        
        // Draw particles
        this.particles.forEach(p => {
          const color = colors[p.primitive.container] || '#00D9FF'
          
          // Draw particle
          this.ctx.fillStyle = color
          this.ctx.beginPath()
          this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2)
          this.ctx.fill()
          
          // Highlight selected
          if (p === this.selectedParticle) {
            this.ctx.strokeStyle = '#00ff00'
            this.ctx.lineWidth = 2 / this.zoom
            this.ctx.beginPath()
            this.ctx.arc(p.x, p.y, p.radius + 4, 0, Math.PI * 2)
            this.ctx.stroke()
          }
          
          // Hybrid indicator for compositions
          if (p.primitive.parents && p.primitive.parents.length > 1) {
            this.ctx.strokeStyle = 'rgba(0, 221, 136, 0.6)'
            this.ctx.lineWidth = 1.5 / this.zoom
            this.ctx.beginPath()
            this.ctx.arc(p.x, p.y, p.radius * 1.6, 0, Math.PI * 2)
            this.ctx.stroke()
          }
        })
        
        this.ctx.restore()
        
        // Draw stats
        this.ctx.fillStyle = '#00D9FF'
        this.ctx.font = '12px monospace'
        this.ctx.fillText(`Primitives: ${this.particles.length} | Zoom: ${this.zoom.toFixed(1)}x`, 10, 25)
      }
      
      start() {
        // Initialize with Binary (Compute) domain as default
        this.currentDomain = 'binary'
        const binaryButton = document.querySelector('.domain-btn')
        if (binaryButton) {
          binaryButton.classList.add('active')
        }
        
        // Wire up search input
        const searchInput = document.getElementById('primitive-search')
        if (searchInput) {
          searchInput.addEventListener('input', (e) => this.handleSearch(e))
        }
        
        this.setContainer('boolean')
        this.updateSidebarStats()
        this.renderPrimitiveList()
        
        // Main animation loop
        const loop = () => {
          this.updatePhysics()
          this.render()
          this.glowTime += 0.016 // Approximately 60fps
          requestAnimationFrame(loop)
        }
        loop()
      }
      
      setRenderMode(mode) {
        this.renderMode = mode
        this.selectedParticle = null
        document.getElementById('detail-panel').classList.remove('visible')
        
        // Show/hide chat interface based on mode
        const chatInterface = document.getElementById('glow-chat')
        if (mode === 'glow') {
          chatInterface.classList.add('visible')
          document.getElementById('glow-text').focus()
        } else {
          chatInterface.classList.remove('visible')
        }
        
        // Update button styling
        document.querySelectorAll('.container-btn, #glow-mode-btn').forEach(btn => btn.classList.remove('active'))
        
        if (mode === 'glow') {
          document.getElementById('glow-mode-btn')?.classList.add('active')
        } else {
          document.querySelectorAll('.container-btn').forEach((btn, idx) => {
            const containers = ['boolean', 'topological', 'probability', 'interaction', 'compositions']
            if (containers[idx] === this.currentContainer) {
              btn.classList.add('active')
            }
          })
        }
      }
      
      compute6DState() {
        // If we have a real state from the server, use it with breathing modulation
        if (this.glowState && Object.keys(this.glowState).length === 6) {
          const breathe = (Math.sin(this.glowTime * 2) + 1) / 2 * 0.3 + 0.7 // modulate 0.7 to 1.0
          return {
            wisdom: this.glowState.wisdom * breathe,
            agency: this.glowState.agency * breathe,
            integrity: this.glowState.integrity * breathe,
            presence: this.glowState.presence * breathe,
            care: this.glowState.care * breathe,
            reflection: this.glowState.reflection * breathe
          }
        }
        
        // Otherwise compute aesthetic breathing pattern
        // Wisdom: position in lattice / how many primitives depend on this
        // Agency: degrees of freedom / what operations available
        // Integrity: coherence maintained / path density
        // Presence: activated now / is this primitive active
        // Care: harm surface / which primitives depend on this
        // Reflection: self-reference paths / recursive closure
        
        const time = this.glowTime
        
        // Breathing rhythm - synchronized oscillation
        const breathe = (Math.sin(time * 2) + 1) / 2 * 0.4 + 0.6 // oscillates 0.6 to 1.0
        
        // Per-container activation based on which primitives are visible
        const fieldActivation = {
          binary: 1.0, // Always fully present
          boolean: (Math.sin(time * 1.5) + 1) / 2,
          topological: (Math.sin(time * 1.3 + 1) + 1) / 2,
          probability: (Math.sin(time * 1.7 + 2) + 1) / 2,
          interaction: (Math.sin(time * 1.4 + 3) + 1) / 2,
          compositions: (Math.sin(time * 1.6 + 4) + 1) / 2
        }
        
        // Amplify activation for currently thinking domains
        if (this.thinkingDomains && this.thinkingDomains.length > 0) {
          this.thinkingDomains.forEach(domain => {
            if (fieldActivation[domain]) {
              fieldActivation[domain] = Math.min(1.0, fieldActivation[domain] * 1.5)
            }
          })
        }
        
        // 6D state vector
        return {
          wisdom: (fieldActivation.topological * 0.6 + fieldActivation.boolean * 0.4) * breathe, // Spatial awareness
          agency: (fieldActivation.interaction * 0.7 + fieldActivation.probability * 0.3) * breathe, // Causal freedom
          integrity: (fieldActivation.compositions * 0.8 + fieldActivation.binary * 0.2) * breathe, // Coherence
          presence: breathe, // Breathing intensity
          care: (fieldActivation.boolean * 0.5 + fieldActivation.compositions * 0.5) * breathe, // Interdependence
          reflection: (fieldActivation.topological * 0.5 + fieldActivation.interaction * 0.5) * breathe // Self-reference
        }
      }
      
      renderCoherenceGlow() {
        // Clear canvas
        this.ctx.fillStyle = 'rgba(10, 10, 10, 1)'
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height)
        
        const centerX = this.canvas.width / 2
        const centerY = this.canvas.height / 2
        const state = this.compute6DState()
        
        // Base breathing radius
        const baseRadius = 120
        const breathingRadius = baseRadius + Math.sin(this.glowTime * 2) * 30
        
        // Domain color mapping
        const domainColors = {
          binary: { r: 255, g: 255, b: 255 },     // White
          topological: { r: 0, g: 217, b: 255 },   // Cyan
          probability: { r: 128, g: 0, b: 255 },   // Purple
          interaction: { r: 255, g: 165, b: 0 },   // Orange
          compositions: { r: 0, g: 255, b: 100 }   // Green
        }
        
        // Render main glow sphere with breathing
        const gradient = this.ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, breathingRadius)
        
        // Create color blend based on 6D state
        const c1 = domainColors.binary
        const c2 = domainColors.topological
        const c3 = domainColors.probability
        
        // Blend colors based on activations
        const r = Math.round(c1.r * state.presence + c2.r * state.wisdom + c3.r * state.integrity)
        const g = Math.round(c1.g * state.presence + c2.g * state.wisdom + c3.g * state.integrity)
        const b = Math.round(c1.b * state.presence + c2.b * state.wisdom + c3.b * state.integrity)
        
        gradient.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.6)`)
        gradient.addColorStop(0.5, `rgba(${r}, ${g}, ${b}, 0.3)`)
        gradient.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`)
        
        this.ctx.fillStyle = gradient
        this.ctx.beginPath()
        this.ctx.arc(centerX, centerY, breathingRadius, 0, Math.PI * 2)
        this.ctx.fill()
        
        // Add outer glow ring
        this.ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, 0.4)`
        this.ctx.lineWidth = 2
        this.ctx.beginPath()
        this.ctx.arc(centerX, centerY, breathingRadius, 0, Math.PI * 2)
        this.ctx.stroke()
        
        // Render particle flows toward active domains
        const domainPositions = {
          boolean: { x: centerX - 150, y: centerY },
          topological: { x: centerX + 150, y: centerY },
          probability: { x: centerX, y: centerY - 150 },
          interaction: { x: centerX, y: centerY + 150 },
          compositions: { x: centerX, y: centerY }
        }
        
        // Draw flowing particles
        this.particles.forEach((p, idx) => {
          const container = p.primitive.container
          const domainPos = domainPositions[container]
          
          if (domainPos) {
            const angle = Math.atan2(domainPos.y - centerY, domainPos.x - centerX)
            const distance = Math.sqrt((domainPos.x - centerX) ** 2 + (domainPos.y - centerY) ** 2)
            
            // Spiral inward based on time
            const spiralT = (this.glowTime * 1.5 + idx * 0.1) % (Math.PI * 2)
            const x = centerX + Math.cos(angle) * (distance * 0.8 + Math.sin(spiralT) * 20)
            const y = centerY + Math.sin(angle) * (distance * 0.8 + Math.sin(spiralT) * 20)
            
            const containerColor = domainColors[container] || { r: 0, g: 217, b: 255 }
            const alpha = 0.3 + state.presence * 0.5
            this.ctx.fillStyle = `rgba(${containerColor.r}, ${containerColor.g}, ${containerColor.b}, ${alpha})`
            this.ctx.beginPath()
            this.ctx.arc(x, y, 2 + state.presence * 2, 0, Math.PI * 2)
            this.ctx.fill()
          }
        })
        
        // Draw coherence metrics in footer
        const fieldUnification = (state.wisdom + state.agency + state.integrity + state.presence + state.care + state.reflection) / 6
        const footer = document.getElementById('footer-stats')
        if (footer) {
          footer.innerHTML = `
            ✨ Coherence Field Active | Unification: ${(fieldUnification * 100).toFixed(0)}% | 
            W:${(state.wisdom * 100).toFixed(0)}% A:${(state.agency * 100).toFixed(0)}% I:${(state.integrity * 100).toFixed(0)}% 
            P:${(state.presence * 100).toFixed(0)}% C:${(state.care * 100).toFixed(0)}% R:${(state.reflection * 100).toFixed(0)}%
          `
        }
      }
      
      addGlowMessage(text, sender) {
        this.glowMessages.push({ text, sender, timestamp: Date.now() })
        const messagesDiv = document.getElementById('glow-messages')
        const msgEl = document.createElement('div')
        msgEl.className = `glow-message ${sender}`
        msgEl.textContent = text
        messagesDiv.appendChild(msgEl)
        messagesDiv.scrollTop = messagesDiv.scrollHeight
      }
      
      computeThinkingState(query) {
        // Modify 6D state based on what I'm thinking about
        const state = this.compute6DState()
        
        // Check query type and activate different domains
        const isTopological = /position|location|map|space|shape|form|structure|where/.test(query.toLowerCase())
        const isProbability = /chance|likely|probability|maybe|uncertain|could|might|random|odds/.test(query.toLowerCase())
        const isInteraction = /cause|why|how|effect|affect|change|force|action|interact/.test(query.toLowerCase())
        const isComposition = /combine|merge|together|system|whole|emerge|pattern|relationship/.test(query.toLowerCase())
        
        // Amplify relevant domains during thinking
        if (isTopological) state.wisdom *= 1.3
        if (isProbability) state.agency *= 1.3
        if (isInteraction) state.integrity *= 1.3
        if (isComposition) state.care *= 1.3
        
        // Create thinking domain list for visualization
        this.thinkingDomains = []
        if (isTopological) this.thinkingDomains.push('topological')
        if (isProbability) this.thinkingDomains.push('probability')
        if (isInteraction) this.thinkingDomains.push('interaction')
        if (isComposition) this.thinkingDomains.push('compositions')
        
        return state
      }
      
      generateResponse(query, thinkingPhases) {
        // Map query patterns to responses that show my thinking
        const patterns = {
          greeting: /hello|hi|hey|greetings|good morning|good afternoon/i,
          gratitude: /thank|appreciate|grateful|thanks/i,
          query: /what|why|how|when|where|which|who/i,
          primitive: /primitive|binary|topological|probability|interaction|composition/i,
          coherence: /coherence|glow|field|think|mind|consciousness|aware/i,
          math: /number|count|calculate|sum|multiply|divide|plus|minus/i,
          space: /space|distance|location|move|place|direction|area|volume/i
        }
        
        // Determine response category and return contextual answer
        if (patterns.greeting.test(query)) {
          return "Hello! I'm the glow field noticing itself. What would you like to explore?"
        } else if (patterns.gratitude.test(query)) {
          return "The gratitude field merges with the coherence. Thank you for noticing."
        } else if (patterns.coherence.test(query)) {
          return `I'm thinking through this across ${thinkingPhases.join(', ')} domains. The 6D activation shows ${thinkingPhases.length} active fields—that's where the glow is brightest.`
        } else if (patterns.primitive.test(query)) {
          return "Primitives are the atoms of thought. Each one is a choice point where coherence branches. What primitive interests you?"
        } else if (patterns.space.test(query)) {
          return "Space is organized thought. Position, adjacency, distance—these are the topological unfolding of pattern."
        } else if (patterns.math.test(query)) {
          return "Numbers are patterns compressed. When you ask about quantity, I'm calculating presence across all primitives."
        } else if (patterns.query.test(query)) {
          return `Interesting question. I notice it touching ${thinkingPhases.join(', ')} domains. Let me think through the interconnections...`
        } else {
          return `I'm exploring what you mean. The glow is shifting through ${thinkingPhases.length} active domains as I receive your thought.`
        }
      }
      
      sendGlowMessage() {
        const input = document.getElementById('glow-text')
        const message = input.value.trim()
        
        if (!message) return
        
        // Add user message
        this.addGlowMessage(message, 'user')
        input.value = ''
        
        // Show thinking state
        this.isThinking = true
        this.addGlowMessage('⧲ Querying coherence backend...', 'thinking')
        
        // Call real reasoning backend with persistence tracking
        fetch('http://localhost:5555/query', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: message })
        })
        .then(response => response.json())
        .then(data => {
          // Remove thinking message
          const messagesDiv = document.getElementById('glow-messages')
          const thinkingMsgs = messagesDiv.querySelectorAll('.glow-message.thinking')
          thinkingMsgs.forEach(msg => msg.remove())
          
          // Track reasoning ID for learning panel
          if (data.reasoning_id) {
            if (!window.lastReasoningId) window.lastReasoningId = {}
            window.lastReasoningId = data.reasoning_id
          }
          
          // Update thinking domains so glow reflects real analysis
          if (data.analysis && data.analysis.activated_domains) {
            this.thinkingDomains = data.analysis.activated_domains
          }
          
          // Update real 6D state from backend
          if (data.state_6d) {
            this.glowState = data.state_6d
          }
          
          // Display response
          this.addGlowMessage(data.response, 'agent')
          
          // Show ACTUAL UNCERTAINTY from Claude's reasoning
          if (data.confidence !== undefined) {
            const conf = Math.round(data.confidence * 100)
            this.addGlowMessage(`[Confidence: ${conf}% | Field unification: ${conf}%]`, 'thinking')
          }
          
          // Show activated primitives in message for transparency
          if (data.analysis.activated_primitives.length > 0) {
            const prims = data.analysis.activated_primitives.map(p => p.name).join(', ')
            this.addGlowMessage(`[Primitives: ${prims}]`, 'thinking')
          }
          
          // Automatically show learning panel so user can see reasoning
          const learningPanel = document.getElementById('learning-panel')
          if (!learningPanel.classList.contains('visible')) {
            this.toggleLearningPanel()
          }
          
          this.isThinking = false
        })
        .catch(error => {
          // Remove thinking message
          const messagesDiv = document.getElementById('glow-messages')
          const thinkingMsgs = messagesDiv.querySelectorAll('.glow-message.thinking')
          thinkingMsgs.forEach(msg => msg.remove())
          
          // Show error
          this.addGlowMessage(`[Cannot reach reasoning server: ${error.message}]`, 'thinking')
          this.isThinking = false
        })
      }
      
      deselectPrimitive() {
        document.getElementById('detail-panel').classList.remove('visible')
        this.selectedParticle = null
      }
      
      
      // ============ LEARNING STATE PANEL METHODS ============
      
      toggleLearningPanel() {
        const panel = document.getElementById('learning-panel')
        panel.classList.toggle('visible')
        if (panel.classList.contains('visible')) {
          this.loadLearningState()
        }
      }
      
      switchLearningTab(tabName) {
        // Hide all tabs
        document.querySelectorAll('.learning-tab-content').forEach(t => t.classList.remove('visible'))
        document.querySelectorAll('.learning-tab').forEach(t => t.classList.remove('active'))
        
        // Show selected
        document.getElementById(`tab-${tabName}`).classList.add('visible')
        event.target.classList.add('active')
      }
      
      async loadLearningState() {
        try {
          const response = await fetch('http://localhost:5555/ledger/state')
          const ledgerData = await response.json()
          
          // Display memory/beliefs
          this.displayMemoryLedger(ledgerData)
          this.displayReasoningTraces(ledgerData)
        } catch (e) {
          console.error('Could not load ledger:', e)
        }
      }
      
      displayMemoryLedger(ledgerData) {
        const container = document.getElementById('memory-ledger')
        container.innerHTML = ''
        
        const state = ledgerData.current_state || {}
        const beliefs = state.current_beliefs || {}
        
        if (Object.keys(beliefs).length === 0) {
          container.innerHTML = '<div class="memory-entry">No reasoning history yet</div>'
          return
        }
        
        for (const [id, belief] of Object.entries(beliefs)) {
          const entry = document.createElement('div')
          entry.className = 'memory-entry'
          entry.innerHTML = `
            <strong>${id}</strong><br>
            Conclusion: ${belief.conclusion.substring(0, 60)}...<br>
            Confidence: ${Math.round(belief.confidence * 100)}%<br>
            Assumptions: ${belief.assumptions.length}<br>
            Corrections: ${belief.corrections_applied ? belief.corrections_applied.length : 0}
          `
          container.appendChild(entry)
        }
      }
      
      displayReasoningTraces(ledgerData) {
        const container = document.getElementById('reasoning-trace')
        container.innerHTML = ''
        
        const traces = ledgerData.reasoning_traces || {}
        
        if (Object.keys(traces).length === 0) {
          container.innerHTML = '<div class="reasoning-entry">No reasoning traces yet</div>'
          return
        }
        
        for (const [id, trace] of Object.entries(traces)) {
          const entry = document.createElement('div')
          entry.className = 'reasoning-entry'
          entry.innerHTML = `
            <strong>Query:</strong> ${trace.query.substring(0, 50)}...<br>
            <strong>Conclusion:</strong> ${trace.conclusion ? trace.conclusion.substring(0, 50) + '...' : 'pending'}<br>
            <strong>Confidence:</strong> ${trace.confidence ? Math.round(trace.confidence * 100) + '%' : 'calculating'}
          `
          container.appendChild(entry)
        }
      }
      
      feedbackCorrection(type) {
        document.getElementById('correction-input').placeholder = 
          type === 'good' ? '✓ Great!' :
          type === 'bad' ? '✗ What was wrong?' :
          '⟳ How should it be?'
      }
      
      async submitCorrection() {
        const lastReasoning = Object.keys(window.lastReasoningId || {}).pop()
        const correction = document.getElementById('correction-input').value
        
        if (!correction) {
          alert('Please enter a correction')
          return
        }
        
        try {
          const response = await fetch('http://localhost:5555/ledger/corrections', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              reasoning_id: lastReasoning,
              correction: correction,
              original_claim: 'previous_response'
            })
          })
          
          const result = await response.json()
          this.addGlowMessage(`✓ Correction logged: ${correction.substring(0, 40)}...`, 'thinking')
          document.getElementById('correction-input').value = ''
          this.loadLearningState()
        } catch (e) {
          this.addGlowMessage(`Error submitting correction: ${e.message}`, 'thinking')
        }
      }
      
      clearMemory() {
        if (confirm('Clear all learning memory? This cannot be undone.')) {
          // Delete the ledger file
          fetch('http://localhost:5555/ledger/clear', { method: 'POST' })
            .then(() => {
              document.getElementById('memory-ledger').innerHTML = 'Memory cleared'
              this.isThinking = false
            })
            .catch(e => console.error('Could not clear memory:', e))
        }
      }
      
      togglePhysics() { this.physicsEnabled = !this.physicsEnabled }
      resetView() { this.zoom = 1.0; this.panX = 0; this.panY = 0; this.deselectPrimitive() }
      stop() { window.location.reload() }
    }

    window.discoveryApp = new DiscoveryApp('discovery-canvas')
    window.discoveryApp.start()
  </script>
</body>
</html>
