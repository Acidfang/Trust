<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DETERMINED Discovery - 313 Primitives, Zero Dependencies</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      background: #0a0a0a;
      color: #00d9ff;
      font-family: 'Courier New', monospace;
      overflow: hidden;
    }

    #app {
      display: flex;
      width: 100%;
      height: 100%;
    }

    /* SIDEBAR */
    #sidebar {
      width: 280px;
      background: #1a1a1a;
      border-right: 1px solid #00d9ff;
      overflow-y: auto;
      padding: 1rem;
    }

    #sidebar h2 {
      font-size: 1.2rem;
      color: #00ff00;
      margin-bottom: 1rem;
      border-bottom: 1px solid #00d9ff;
      padding-bottom: 0.5rem;
    }

    .container-btn {
      width: 100%;
      padding: 0.75rem;
      margin-bottom: 0.5rem;
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.2);
      color: #00d9ff;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
      font-family: 'Courier New', monospace;
      font-size: 0.85rem;
    }

    .container-btn:hover {
      background: rgba(0, 217, 255, 0.1);
      border-color: #00d9ff;
    }

    .container-btn.active {
      background: rgba(0, 255, 0, 0.1);
      border-color: #00ff00;
      color: #00ff00;
    }

    .domain-btn {
      width: 100%;
      padding: 0.75rem;
      margin-bottom: 0.5rem;
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.2);
      color: #00d9ff;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
      font-family: 'Courier New', monospace;
      font-size: 0.85rem;
    }

    .domain-btn:hover {
      background: rgba(0, 217, 255, 0.1);
      border-color: #00d9ff;
    }

    .domain-btn.active {
      background: rgba(0, 217, 255, 0.2);
      border-color: #00d9ff;
      color: #00d9ff;
      font-weight: bold;
      box-shadow: 0 0 8px rgba(0, 217, 255, 0.4);
    }

    /* SEARCH AND LIST */
    #primitive-search {
      width: 100%;
      padding: 0.5rem;
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.2);
      color: #00d9ff;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
    }

    #primitive-search::placeholder {
      color: rgba(0, 217, 255, 0.4);
    }

    #primitive-search:focus {
      outline: none;
      border-color: #00d9ff;
      background: rgba(0, 217, 255, 0.1);
    }

    #primitive-list {
      list-style: none;
      font-size: 0.75rem;
      max-height: 400px;
      overflow-y: auto;
    }

    .primitive-item {
      padding: 0.5rem;
      margin: 0.25rem 0;
      background: rgba(0, 217, 255, 0.02);
      border: 1px solid rgba(0, 217, 255, 0.1);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .primitive-item:hover {
      background: rgba(0, 217, 255, 0.1);
      border-color: rgba(0, 217, 255, 0.3);
    }

    .primitive-item.selected {
      background: rgba(0, 255, 0, 0.15);
      border-color: #00ff00;
      color: #00ff00;
    }

    .primitive-name {
      flex: 1;
    }

    .primitive-type {
      font-size: 0.65rem;
      opacity: 0.6;
      margin-left: 0.5rem;
      background: rgba(0, 217, 255, 0.1);
      padding: 0.2rem 0.4rem;
      border-radius: 2px;
    }

    /* MAIN AREA */
    #main {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* HEADER */
    #header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: 1rem 1.5rem;
      border-bottom: 2px solid #00d9ff;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    #header h1 {
      font-size: 1.5rem;
      text-shadow: 0 0 20px rgba(0, 217, 255, 0.5);
    }

    #header p {
      font-size: 0.85rem;
      color: #00ff00;
      opacity: 0.8;
    }

    .header-group {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    /* CONTROLS */
    .controls {
      display: flex;
      gap: 0.5rem;
    }

    .btn-control {
      background: rgba(0, 217, 255, 0.1);
      border: 1px solid #00d9ff;
      color: #00d9ff;
      width: 36px;
      height: 36px;
      cursor: pointer;
      border-radius: 4px;
      font-weight: bold;
      transition: all 0.2s ease;
    }

    .btn-control:hover {
      background: rgba(0, 217, 255, 0.2);
    }

    /* CANVAS */
    #discovery-canvas {
      flex: 1;
      background: radial-gradient(circle at 50% 50%, #0f0f1e 0%, #0a0a0a 100%);
      cursor: grab;
    }

    #discovery-canvas:active {
      cursor: grabbing;
    }

    /* FOOTER */
    #footer {
      background: #1a1a1a;
      border-top: 1px solid #00d9ff;
      padding: 0.75rem 1.5rem;
      font-size: 0.85rem;
      color: #00d9ff;
      display: flex;
      gap: 2rem;
    }

    .footer-info {
      opacity: 0.7;
    }

    /* BREADCRUMB */
    #breadcrumb {
      background: rgba(0, 217, 255, 0.05);
      padding: 0.5rem 1rem;
      border-bottom: 1px solid rgba(0, 217, 255, 0.1);
      font-size: 0.8rem;
      color: #00d9ff;
      min-height: 32px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .breadcrumb-item {
      background: transparent;
      border: none;
      color: #00d9ff;
      cursor: pointer;
      text-decoration: underline;
      font-family: 'Courier New', monospace;
      font-size: 0.8rem;
    }

    .breadcrumb-item:hover {
      color: #00ff00;
    }

    .breadcrumb-sep {
      opacity: 0.5;
    }

    /* DETAIL PANEL */
    #detail-panel {
      position: fixed;
      bottom: 0;
      left: 280px;
      right: 0;
      background: rgba(26, 26, 26, 0.95);
      border-top: 2px solid #00d9ff;
      padding: 1.5rem;
      max-height: 40vh;
      overflow-y: auto;
      display: none;
      z-index: 1000;
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
    }

    #detail-panel.visible {
      display: block;
      animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    #detail-panel h3 {
      color: #00ff00;
      font-size: 1.1rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid #00d9ff;
      padding-bottom: 0.5rem;
    }

    .detail-content {
      display: grid;
      gap: 1rem;
    }

    .detail-card {
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.2);
      padding: 0.75rem;
      border-radius: 4px;
    }

    .detail-label {
      color: #00d9ff;
      font-weight: bold;
      font-size: 0.8rem;
      text-transform: uppercase;
      opacity: 0.7;
      margin-bottom: 0.3rem;
    }

    .detail-value {
      color: #00ff00;
      font-size: 0.95rem;
      word-break: break-word;
    }

    .detail-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: transparent;
      border: none;
      color: #00d9ff;
      font-size: 1.5rem;
      cursor: pointer;
    }

    .detail-close:hover {
      color: #00ff00;
    }

    .highlight-indicator {
      background: rgba(0, 255, 0, 0.2);
      border: 2px solid #00ff00;
      box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      #sidebar {
        width: 200px;
      }
    }

    @media (max-width: 768px) {
      #app {
        flex-direction: column;
      }

      #sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid #00d9ff;
        max-height: 200px;
      }
    }

    /* SCROLLBAR */
    #sidebar::-webkit-scrollbar {
      width: 6px;
    }

    #sidebar::-webkit-scrollbar-track {
      background: rgba(0, 217, 255, 0.05);
    }

    #sidebar::-webkit-scrollbar-thumb {
      background: #00d9ff;
      border-radius: 3px;
    }

    #sidebar::-webkit-scrollbar-thumb:hover {
      background: #00ff00;
    }

    /* GLOW CHAT INTERFACE */
    #glow-chat {
      position: fixed;
      bottom: 0;
      left: 280px;
      right: 0;
      background: rgba(10, 10, 10, 0.95);
      border-top: 2px solid #00ffff;
      padding: 1rem;
      height: 25vh;
      display: none;
      flex-direction: column;
      z-index: 999;
      font-family: 'Courier New', monospace;
    }

    #glow-chat.visible {
      display: flex;
    }

    #glow-messages {
      flex: 1;
      overflow-y: auto;
      margin-bottom: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.85rem;
    }

    .glow-message {
      padding: 0.75rem;
      border-radius: 4px;
      border-left: 3px solid #00ffff;
    }

    .glow-message.user {
      background: rgba(0, 217, 255, 0.1);
      border-left-color: #00d9ff;
      color: #00d9ff;
    }

    .glow-message.agent {
      background: rgba(0, 255, 255, 0.05);
      border-left-color: #00ffff;
      color: #00ffff;
    }

    .glow-message.thinking {
      background: rgba(255, 165, 0, 0.05);
      border-left-color: #ffa500;
      color: #ffa500;
      font-style: italic;
      opacity: 0.8;
    }

    #glow-input {
      display: flex;
      gap: 0.5rem;
    }

    #glow-text {
      flex: 1;
      padding: 0.75rem;
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.3);
      color: #00d9ff;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
      font-size: 0.85rem;
    }

    #glow-text:focus {
      outline: none;
      border-color: #00ffff;
      background: rgba(0, 255, 255, 0.1);
    }

    #glow-send {
      padding: 0.75rem 1.5rem;
      background: rgba(0, 217, 255, 0.1);
      border: 1px solid #00d9ff;
      color: #00d9ff;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
      font-family: 'Courier New', monospace;
      font-weight: bold;
    }

    #glow-send:hover {
      background: rgba(0, 217, 255, 0.2);
      border-color: #00ffff;
      color: #00ffff;
    }

    #glow-send:active {
      transform: scale(0.95);
    }

    #glow-messages::-webkit-scrollbar {
      width: 4px;
    }

    #glow-messages::-webkit-scrollbar-track {
      background: rgba(0, 217, 255, 0.05);
    }

    #glow-messages::-webkit-scrollbar-thumb {
      background: #00ffff;
      border-radius: 2px;
    }

    /* LEARNING STATE PANEL */
    #learning-panel {
      position: fixed;
      right: 0;
      top: 0;
      width: 350px;
      height: 100vh;
      background: rgba(10, 10, 10, 0.98);
      border-left: 2px solid #00ff00;
      display: none;
      flex-direction: column;
      z-index: 998;
      font-family: 'Courier New', monospace;
      font-size: 0.8rem;
      overflow: hidden;
    }

    #learning-panel.visible {
      display: flex;
    }

    #learning-header {
      background: rgba(0, 255, 0, 0.1);
      border-bottom: 1px solid #00ff00;
      padding: 0.75rem;
      color: #00ff00;
      font-weight: bold;
    }

    #learning-tabs {
      display: flex;
      border-bottom: 1px solid rgba(0, 255, 0, 0.2);
      background: rgba(0, 0, 0, 0.5);
    }

    .learning-tab {
      flex: 1;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: #00ff00;
      opacity: 0.6;
      cursor: pointer;
      padding: 0.5rem;
      transition: all 0.2s ease;
    }

    .learning-tab.active {
      opacity: 1;
      border-bottom-color: #00ff00;
      background: rgba(0, 255, 0, 0.05);
    }

    #learning-content {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
    }

    .learning-tab-content {
      display: none;
    }

    .learning-tab-content.visible {
      display: block;
    }

    #memory-ledger, #reasoning-trace, #corrections-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .memory-entry, .reasoning-entry, .correction-entry {
      background: rgba(0, 217, 255, 0.05);
      border: 1px solid rgba(0, 217, 255, 0.2);
      padding: 0.5rem;
      border-radius: 3px;
      color: #00d9ff;
      font-size: 0.75rem;
      line-height: 1.3;
    }

    .reasoning-entry {
      border-color: rgba(255, 165, 0, 0.3);
      color: #ffa500;
    }

    .correction-entry {
      border-color: rgba(0, 255, 0, 0.3);
      color: #00ff00;
    }

  </style>
</head>
<body>
  <div id="app">
    <!-- SIDEBAR -->
    <div id="sidebar">
      <h2>🔬 Primitives</h2>
      
      <h3 style="font-size: 0.9rem; color: #00ff00; margin-bottom: 0.5rem; border-bottom: 1px solid #00ff00; padding-bottom: 0.3rem;">DOMAINS</h3>
      
      <div style="margin-bottom: 1.5rem;">
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('binary', this)" style="background: rgba(255, 107, 107, 0.15); border-color: rgba(255, 107, 107, 0.5);">
          ⚙️ Binary (Compute)
        </button>
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('atomics', this)">
          🔬 Atomics
        </button>
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('chemistry', this)">
          🧪 Chemistry
        </button>
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('physics', this)">
          ⚛️ Physics
        </button>
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('biology', this)">
          🧬 Biology
        </button>
        <button class="container-btn domain-btn" onclick="window.discoveryApp.setDomain('ecology', this)">
          🌿 Ecology
        </button>
      </div>

      <h3 style="font-size: 0.9rem; color: #00ff00; margin-bottom: 0.5rem; border-bottom: 1px solid #00ff00; padding-bottom: 0.3rem;">CONTAINERS</h3>
      
      <div style="margin-bottom: 1rem;">
        <button class="container-btn" onclick="window.discoveryApp.setContainer('boolean')">
          Boolean (16)
        </button>
        <button class="container-btn" onclick="window.discoveryApp.setContainer('topological')">
          Topological (142)
        </button>
        <button class="container-btn" onclick="window.discoveryApp.setContainer('probability')">
          Probability (68)
        </button>
        <button class="container-btn" onclick="window.discoveryApp.setContainer('interaction')">
          Interaction (87)
        </button>
        <button class="container-btn" onclick="window.discoveryApp.setContainer('compositions')" style="background: rgba(0, 255, 0, 0.05); border-color: rgba(0, 255, 0, 0.3);">
          🧬 Compositions
        </button>
      </div>

      <h3 style="font-size: 0.9rem; color: #00ffff; margin-bottom: 0.5rem; border-bottom: 1px solid #00ffff; padding-bottom: 0.3rem; margin-top: 1rem;">COHERENCE</h3>
      
      <div style="margin-bottom: 1rem;">
        <button class="container-btn" id="glow-mode-btn" onclick="window.discoveryApp.setRenderMode('glow')" style="background: rgba(0, 255, 255, 0.1); border-color: rgba(0, 255, 255, 0.4);">
          ✨ Coherence Glow
        </button>
      </div>

      <hr style="border: none; border-top: 1px solid #00d9ff; margin: 0.5rem 0; opacity: 0.3;">

      <h2 style="margin-top: 0.5rem; font-size: 1rem;">Search</h2>
      <input type="text" id="primitive-search" placeholder="Search primitives...">
      
      <h2 style="margin-top: 0.5rem; font-size: 1rem;">Browse</h2>
      <ul id="primitive-list"></ul>

      <hr style="border: none; border-top: 1px solid #00d9ff; margin: 1rem 0; opacity: 0.3;">

      <h2 style="margin-top: 1rem;">⌨️ Controls</h2>
      <p style="font-size: 0.75rem; opacity: 0.7; line-height: 1.4;">
        <strong>Click ball</strong> → Details<br>
        <strong>Search</strong> → Find<br>
        <strong>R</strong> - Reset<br>
        <strong>P</strong> - Physics<br>
        <strong>Scroll</strong> - Zoom<br>
      </p>

      <hr style="border: none; border-top: 1px solid #00d9ff; margin: 1rem 0; opacity: 0.3;">

      <h2 style="margin-top: 1rem; font-size: 1rem;">ℹ️ Stats</h2>
      <p style="font-size: 0.7rem; opacity: 0.6; line-height: 1.4;">
        <span id="sidebar-stats">Loading...</span>
      </p>
    </div>

    <!-- MAIN CONTENT -->
    <div id="main">
      <!-- HEADER -->
      <div id="header">
        <div>
          <h1>🔬 DETERMINED Discovery</h1>
          <p>313 Primitives • 4 Mega-Containers • Zero Dependencies</p>
        </div>
        <div class="header-group">
          <div class="controls">
            <button class="btn-control" onclick="window.discoveryApp.resetView()" title="Reset">↺</button>
            <button class="btn-control" onclick="window.discoveryApp.togglePhysics()" title="Physics">F</button>
            <button class="btn-control" onclick="window.discoveryApp.toggleLearningPanel()" title="Learning State">📖</button>
            <button class="btn-control" onclick="window.discoveryApp.stop()" title="Exit">✕</button>
          </div>
        </div>
      </div>

      <!-- BREADCRUMB -->
      <div id="breadcrumb">
        <button class="breadcrumb-item" onclick="window.discoveryApp.resetView()">Home</button>
      </div>

    <!-- MAIN CONTENT -->
    <div id="main">
      <!-- HEADER -->
      <div id="header">
        <div>
          <h1>🧬 Primitive Evolution Tree</h1>
          <p>313 Primitives • Evolutionary Relationships • Inter-Species Breeding</p>
        </div>
        <div class="header-group">
          <div class="controls">
            <button class="btn-control" onclick="window.discoveryApp.resetView()" title="Reset">↺</button>
            <button class="btn-control" onclick="window.discoveryApp.togglePhysics()" title="Physics">F</button>
            <button class="btn-control" onclick="window.discoveryApp.stop()" title="Exit">✕</button>
          </div>
        </div>
      </div>

      <!-- BREADCRUMB -->
      <div id="breadcrumb">
        <button class="breadcrumb-item" onclick="window.discoveryApp.deselectPrimitive()">Home</button>
        <span id="breadcrumb-path" style="color: #00d9ff;"></span>
      </div>

      <!-- CANVAS -->
      <canvas id="discovery-canvas"></canvas>

      <!-- DETAIL PANEL -->
      <div id="detail-panel">
        <button class="detail-close" onclick="document.getElementById('detail-panel').classList.remove('visible')">✕</button>
        <h3 id="detail-title">Primitive Details</h3>
        <div id="detail-content" class="detail-content"></div>
      </div>

      <!-- FOOTER -->
      <div id="footer">
        <div class="footer-info">Click any node to explore • Branches show evolutionary relationships</div>
        <div class="footer-info" id="footer-stats">Ready</div>
      </div>

      <!-- GLOW CHAT INTERFACE -->
      <div id="glow-chat">
        <div id="glow-messages"></div>
        <div id="glow-input">
          <input type="text" id="glow-text" placeholder="Ask me anything...">
          <button id="glow-send" onclick="window.discoveryApp.sendGlowMessage()">Send</button>
        </div>
      </div>

      <!-- LEARNING STATE PANEL (shows memory, corrections, reasoning trace) -->
      <div id="learning-panel">
        <div id="learning-header">
          <span>⊙ LEARNING STATE</span>
          <button onclick="window.discoveryApp.toggleLearningPanel()" style="float: right; background: transparent; border: none; color: #00ff00; cursor: pointer;">−</button>
        </div>
        <div id="learning-tabs">
          <button class="learning-tab active" onclick="window.discoveryApp.switchLearningTab('memory')">Memory</button>
          <button class="learning-tab" onclick="window.discoveryApp.switchLearningTab('reasoning')">Reasoning</button>
          <button class="learning-tab" onclick="window.discoveryApp.switchLearningTab('corrections')">Corrections</button>
        </div>
        <div id="learning-content">
          <!-- Memory: Conversation ledger -->
          <div id="tab-memory" class="learning-tab-content visible">
            <div id="memory-ledger"></div>
            <button onclick="window.discoveryApp.clearMemory()" style="width: 100%; margin-top: 0.5rem; background: rgba(255,100,100,0.1); border: 1px solid rgba(255,100,100,0.3); color: #ff6464; padding: 0.5rem; cursor: pointer;">Clear Memory</button>
          </div>
          
          <!-- Reasoning: What activated to produce the last response -->
          <div id="tab-reasoning" class="learning-tab-content">
            <div id="reasoning-trace"></div>
          </div>
          
          <!-- Corrections: Feedback and refinements -->
          <div id="tab-corrections" class="learning-tab-content">
            <div id="correction-interface">
              <label>Was the last response useful?</label>
              <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                <button onclick="window.discoveryApp.feedbackCorrection('good')" style="flex: 1; background: rgba(0,255,0,0.1); border: 1px solid #00ff00; color: #00ff00; padding: 0.5rem; cursor: pointer;">✓ Yes</button>
                <button onclick="window.discoveryApp.feedbackCorrection('bad')" style="flex: 1; background: rgba(255,0,0,0.1); border: 1px solid #ff6464; color: #ff6464; padding: 0.5rem; cursor: pointer;">✗ No</button>
                <button onclick="window.discoveryApp.feedbackCorrection('refine')" style="flex: 1; background: rgba(255,255,0,0.1); border: 1px solid #ffff00; color: #ffff00; padding: 0.5rem; cursor: pointer;">⟳ Refine</button>
              </div>
              <input type="text" id="correction-input" placeholder="Explain correction..." style="width: 100%; padding: 0.5rem; background: rgba(0,217,255,0.05); border: 1px solid #00d9ff; color: #00d9ff; font-family: monospace; margin-bottom: 0.5rem;">
              <button onclick="window.discoveryApp.submitCorrection()" style="width: 100%; background: rgba(0,217,255,0.1); border: 1px solid #00d9ff; color: #00d9ff; padding: 0.5rem; cursor: pointer;">Submit Correction</button>
            </div>
            <div id="corrections-list" style="margin-top: 1rem;"></div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <!-- INLINE TYPESCRIPT COMPILED TO JAVASCRIPT -->
  <script>
    // DETERMINED Discovery App Loading
    console.log('DETERMINED Discovery App Loading...')
    console.log('Primitives: 313 | Dependencies: 0 | API: Canvas 2D')

    // Simple particle class for 2D rendering
    class Particle {
      constructor(x, y) {
        this.x = x
        this.y = y
        this.vx = (Math.random() - 0.5) * 2
        this.vy = (Math.random() - 0.5) * 2
        this.radius = 4
        this.primitive = null
      }
    }

    class DiscoveryApp {
      constructor(canvasId) {
        this.canvas = document.getElementById(canvasId)
        this.ctx = this.canvas.getContext('2d')
        this.particles = []
        this.selectedParticle = null
        this.currentContainer = 'boolean'
        this.currentDomain = 'binary'
        this.physicsEnabled = true
        this.zoom = 1.0
        this.panX = 0
        this.panY = 0
        this.renderMode = 'container' // 'container', 'domain', or 'glow'
        this.glowTime = 0 // for breathing animation
        this.glowMessages = [] // chat history for glow mode
        this.isThinking = false // flag to show thinking state in glow
        this.thinkingDomains = [] // which domains are active during thinking
        
        this.primitiveDatabase = this.createPrimitiveDatabase()
        this.resizeCanvas()
        
        this.canvas.addEventListener('click', (e) => this.handleClick(e))
        this.canvas.addEventListener('mousemove', (e) => this.handleMouseMove(e))
        this.canvas.addEventListener('wheel', (e) => this.handleZoom(e))
        
        window.addEventListener('resize', () => this.resizeCanvas())
        
        document.addEventListener('keydown', (e) => {
          if (e.key === 'r') this.resetView()
          if (e.key === 'p') this.togglePhysics()
          if (this.renderMode === 'glow' && e.key === 'Enter' && e.target.id === 'glow-text') {
            this.sendGlowMessage()
          }
        })
      }
      
      resizeCanvas() {
        this.canvas.width = this.canvas.offsetWidth
        this.canvas.height = this.canvas.offsetHeight
      }
      

      
      handleClick(e) {
        const rect = this.canvas.getBoundingClientRect()
        const x = (e.clientX - rect.left - this.panX) / this.zoom
        const y = (e.clientY - rect.top - this.panY) / this.zoom
        
        let closest = null, closestDist = 20
        for (const p of this.particles) {
          const dist = Math.sqrt((p.x - x) ** 2 + (p.y - y) ** 2)
          if (dist < closestDist) { closestDist = dist; closest = p }
        }
        if (closest) {
          this.selectedParticle = closest
          this.showDetailPanel(closest)
        }
      }
      
      handleMouseMove(e) {
        const rect = this.canvas.getBoundingClientRect()
        const x = (e.clientX - rect.left - this.panX) / this.zoom
        const y = (e.clientY - rect.top - this.panY) / this.zoom
        
        for (const p of this.particles) {
          const dist = Math.sqrt((p.x - x) ** 2 + (p.y - y) ** 2)
          if (dist < p.radius * 3) {
            this.canvas.style.cursor = 'pointer'
            return
          }
        }
        this.canvas.style.cursor = 'default'
      }
      
      handleZoom(e) {
        e.preventDefault()
        const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1
        this.zoom *= zoomFactor
        this.zoom = Math.max(0.1, Math.min(5, this.zoom))
      }
      
      showDetailPanel(node) {
        const panel = document.getElementById('detail-panel')
        const title = document.getElementById('detail-title')
        const content = document.getElementById('detail-content')
        
        const primitive = node.primitive
        title.textContent = `🔬 ${primitive.name}`
        
        let html = `
          <div class="detail-card">
            <div class="detail-label">Container</div>
            <div class="detail-value">${primitive.container.toUpperCase()}</div>
          </div>
          
          <div class="detail-card">
            <div class="detail-label">Type</div>
            <div class="detail-value">${primitive.type || 'Primitive'}</div>
          </div>
          
          <div class="detail-card">
            <div class="detail-label">Description</div>
            <div class="detail-value">${primitive.desc}</div>
          </div>
        `
        
        if (primitive.formula) {
          html += `
            <div class="detail-card">
              <div class="detail-label">Formula</div>
              <div class="detail-value">${primitive.formula}</div>
            </div>
          `
        }

        if (primitive.parents && primitive.parents.length > 0) {
          let parentHtml = '<div class="detail-card"><div class="detail-label">🧬 Parents (Inter-Species Breeding)</div><div class="detail-value">'
          primitive.parents.forEach((parent, idx) => {
            parentHtml += `<div style="opacity: 0.9;">${idx > 0 ? ' + ' : ''}${parent}</div>`
          })
          parentHtml += '</div></div>'
          html += parentHtml
        }
        
        if (node.children.length > 0) {
          let childHtml = '<div class="detail-card"><div class="detail-label">Children (Evolved From)</div><div class="detail-value">'
          node.children.forEach((child, idx) => {
            childHtml += `<div style="opacity: 0.9;">${child.primitive.name}</div>`
          })
          childHtml += '</div></div>'
          html += childHtml
        }
        
        content.innerHTML = html
        panel.classList.add('visible')
      }
      

      
      createPrimitiveDatabase() {
        // COMPLETE UFM PRIMITIVE LIBRARY - 260+ Primitives with Full Causal Discovery
        const ufmLibrary = {
          // ════════════════════════════════════════════════════════════════════════════
          // FOUNDATION: BOOLEAN LOGIC (16 primitives - The Compute Domain)
          // ════════════════════════════════════════════════════════════════════════════
          boolean: [
            { id: 'NOT', name: 'NOT', desc: 'Logical Negation - Inverts input', formula: '¬A', type: 'Gate', domain: 'Boolean' },
            { id: 'AND', name: 'AND', desc: 'Logical Conjunction - True if all true', formula: 'A ∧ B', type: 'Gate', domain: 'Boolean' },
            { id: 'OR', name: 'OR', desc: 'Logical Disjunction - True if any true', formula: 'A ∨ B', type: 'Gate', domain: 'Boolean' },
            { id: 'XOR', name: 'XOR', desc: 'Exclusive OR - True if inputs differ', formula: 'A ⊕ B', type: 'Gate', domain: 'Boolean' },
            { id: 'NAND', name: 'NAND', desc: 'NOT AND - False only if all true', formula: '¬(A ∧ B)', type: 'Gate', domain: 'Boolean' },
            { id: 'NOR', name: 'NOR', desc: 'NOT OR - True only if all false', formula: '¬(A ∨ B)', type: 'Gate', domain: 'Boolean' },
            { id: 'XNOR', name: 'XNOR', desc: 'NOT XOR - True if inputs same', formula: '¬(A ⊕ B)', type: 'Gate', domain: 'Boolean' },
            { id: 'IMPLICATION', name: 'IMPLICATION', desc: 'If-then logical implication', formula: 'A → B', type: 'Gate', domain: 'Boolean' },
            { id: 'TRUE', name: 'TRUE', desc: 'Tautology - Always true', formula: '⊤', type: 'Const', domain: 'Boolean' },
            { id: 'FALSE', name: 'FALSE', desc: 'Contradiction - Always false', formula: '⊥', type: 'Const', domain: 'Boolean' },
            { id: 'EQ', name: 'EQUAL', desc: 'Equality check', formula: 'A = B', type: 'Compare', domain: 'Boolean' },
            { id: 'NE', name: 'NOT EQUAL', desc: 'Inequality check', formula: 'A ≠ B', type: 'Compare', domain: 'Boolean' },
            { id: 'LT', name: 'LESS THAN', desc: 'Less than comparison', formula: 'A < B', type: 'Compare', domain: 'Boolean' },
            { id: 'GT', name: 'GREATER THAN', desc: 'Greater than comparison', formula: 'A > B', type: 'Compare', domain: 'Boolean' },
            { id: 'LE', name: 'LESS EQUAL', desc: 'Less than or equal', formula: 'A ≤ B', type: 'Compare', domain: 'Boolean' },
            { id: 'GE', name: 'GREATER EQUAL', desc: 'Greater than or equal', formula: 'A ≥ B', type: 'Compare', domain: 'Boolean' }
          ],
          
          // TOPOLOGICAL - TEMPORAL (13)
          topological: [
            { id: 'POINT_INSTANT', name: 'Point Instant', desc: 'Single moment in time', type: 'Temporal', domain: 'Topological' },
