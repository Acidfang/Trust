  },
  "app": {
    "name": "LEDGER TRANSLATOR",
    "title": "DETERMINED \u00e2\u20ac\u201d Ledger Translator",
    "singularity": {
      "identity": "PURE_LEDGER_VISUALIZATION_ENGINE",
      "purpose": "Read any ledger file and render it as 3D visualization"
    },
    "coherence": 0.99,
    "frequency_hz": 60
  },
  "ui_specification": {
    "theme": {
      "background": "#000000",
      "text_color": "#00FF41",
      "border_color": "#00FF41",
      "accent_colors": {
        "heading": "#FF00FF",
        "success": "#00FF00",
        "warning": "#FFFF00",
        "danger": "#FF0000"
      }
    },
    "canvas": {
      "id": "canvas",
      "width": "100%",
      "height": "100vh",
      "engine": "three.js",
      "camera_fov": 75,
      "camera_position": [
        0,
        200,
        300
      ],
      "camera_look_at": [
        0,
        0,
        0
      ]
    },
    "panels": {
      "ledger_display": {
        "id": "ledgerPanel",
        "position": "top-left",
        "width": 500,
        "height": "80vh",
        "content": "ledger entry data",
        "visible": true
      },
      "controls": {
        "id": "controls",
        "position": "bottom-right",
        "content": "help text and interaction buttons",
        "visible": true,
        "buttons": [
          {
            "id": "whereAmIBtn",
            "label": "Where am I?",
            "action": "focus_on_user_location",
            "description": "Geolocation: Find user's position on Earth and focus camera there"
          }
        ]
      }
    }
  },
  "data_loading": {
    "source": "ledgers.json",
    "format": "JSON",
    "fallback": "embedded",
    "entities": [
      "universe",
      "sun",
      "earth",
      "moon"
    ],
    "note": "Moon loaded - all UFM primitives present in ledger entry",
    "update_frequency": "on-demand"
  },
  "computation_spec": {
    "position": {
      "source": "singularity.location",
      "type": "[x, y, z]",
      "mapping": "direct to THREE.Vector3"
    },
    "color": {
      "source": "coherence",
      "type": "\u00cf\u201e value (0-1)",
      "mapping": [
        {
          "threshold": 0.98,
          "color": "0x00FF00",
          "label": "max coherence"
        },
        {
          "threshold": 0.95,
          "color": "0x00FF99",
          "label": "high coherence"
        },
        {
          "threshold": 0.9,
          "color": "0xFFFF00",
          "label": "strong coherence"
        },
        {
          "threshold": 0.8,
          "color": "0xFF7700",
          "label": "moderate coherence"
        },
        {
          "threshold": 0,
          "color": "0xFF0000",
          "label": "low coherence"
        }
      ]
    },
    "size": {
      "source": "mass_kg",
      "type": "logarithmic scale",
      "mapping": [
        {
          "threshold": 1e+30,
          "radius": 12,
          "label": "sun-scale"
        },
        {
          "threshold": 1e+24,
          "radius": 6,
          "label": "earth-scale"
        },
        {
          "threshold": 1e+22,
          "radius": 3,
          "label": "moon-scale"
        },
        {
          "default": 1.5,
          "label": "default"
        }
      ]
    },
    "opacity": {
      "source": "coherence",
      "formula": "0.3 + coherence * 0.7",
      "range": [
        0.3,
        1.0
      ]
    },
    "animation_rotation": {
      "source": "frequency_hz",
      "formula": "rotation += frequency_hz * 0.001 per frame",
      "axes": [
        "x",
        "y"
      ]
    },
    "animation_pulse": {
      "source": "coherence",
      "formula": "scale = 0.5 + 0.3 * sin(time * coherence)",
      "frequency_source": "coherence_hz"
    }
  },
  "interaction_spec": {
    "mouse_drag": {
      "event": "mousemove + mousedown",
      "action": "rotate_camera",
      "control_type": "arcball",
      "center": [
        0,
        0,
        0
      ]
    },
    "mouse_scroll": {
      "event": "wheel",
      "action": "zoom",
      "zoom_factor": 1.1
    },
    "mouse_click": {
      "event": "click",
      "action": "raycast",
      "on_hit": "display_ledger_entry",
      "on_hit_action": "show_panel_with_data"
    },
    "mouse_hover": {
      "event": "mousemove",
      "trigger": "hover over object named 'SUN'",
      "action": "show_orbital_paths",
      "paths_to_show": [
        "orbit-earth",
        "orbit-moon",
        "connection-sun-earth"
      ]
    },
    "keyboard": {
      "space": {
        "action": "toggle_ui_visibility"
      },
      "r": {
        "action": "reset_view"
      }
    },
    "where_am_i": {
      "status": "SPECIFIED - implementation pending",
      "event": "click on whereAmIBtn",
      "action": "geolocation_focus",
      "process": [
        "1. Request browser geolocation (latitude, longitude)",
        "2. Convert geo coordinates to Earth's position in 3D space",
        "3. Create marker at user's location on Earth surface",
        "4. Focus camera on marker",
        "5. Display user's coordinates in panel"
      ],
      "earth_position": "computed from singularity.location [400.113, 0, 74.715]",
      "earth_radius_units": 6.371,
      "conversion": "latitude/longitude \u00e2\u2020\u2019 3D spherical position relative to Earth center",
      "implementation_note": "Specification complete in ledger. HTML to be generated from this spec when UI generator is built. Currently specification only - button not yet in HTML."
    }
  },
  "orbital_paths_spec": {
    "earth_orbit": {
      "center": "sun position",
      "radius": "earth.distance_from_sun_km / 1000000",
      "segments": 128,
      "color": "0x00CCFF",
      "opacity": 0.3,
      "visible_on": "sun_mouseover"
    },
    "moon_orbit": {
      "center": [
        0,
        0,
        0
      ],
      "radius": "moon.orbital_distance_km / 1000000",
      "segments": 128,
      "color": "0xAAAAAA",
      "opacity": 0.3,
      "visible_on": "sun_mouseover"
    },
    "connection_universe_sun": {
      "from": "universe position",
      "to": "sun position",
      "color": "0xFF0000",
      "opacity": 0.5,
      "visible_on": "sun_mouseover"
    },
    "connection_sun_earth": {
      "from": "sun position",
      "to": "earth position",
      "color": "0xFFFF00",
      "opacity": 0.5,
      "visible_on": "sun_mouseover"
    }
  },
