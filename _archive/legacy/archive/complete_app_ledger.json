  "rendering_architecture": {
    "timeline_split": {
      "enabled": true,
      "purpose": "Compare multiple rendering implementations in parallel",
      "rationale": "Enables architectural exploration, maintains causal chain visibility, preserves working code while adding new implementations",
      "timelines": {
        "timeline_a": {
          "name": "2D Canvas",
          "engine": "Canvas 2D Context",
          "status": "reference implementation - working",
          "when_active": "User selects 'Timeline A: 2D' button",
          "preserves": "All original 2D rendering code unchanged",
          "rendering": "ctx.arc() circles for celestial objects, 2D color particles for phases"
        },
        "timeline_b": {
          "name": "3D THREE.js",
          "engine": "three.js WebGL",
          "status": "new implementation under development",
          "when_active": "User selects 'Timeline B: 3D' button",
          "replaces": "None (runs alongside Timeline A)",
          "rendering": "THREE.Mesh spheres for celestial objects, THREE.Points point clouds for phases"
        }
      },
      "ui": {
        "toggle_buttons": {
          "location": "top-left corner",
          "buttons": [
            {"id": "timelineA", "label": "Timeline A: 2D", "onclick": "switchTimeline('2d')"},
            {"id": "timelineB", "label": "Timeline B: 3D", "onclick": "switchTimeline('3d')"}
          ],
          "state_property": "currentTimeline (reads from)",
          "styling": "active button highlighted, inactive dimmed"
        }
      },
      "html_generation": {
        "rule": "determined_server.py reads timeline_split.enabled from this spec",
        "if_enabled_true": "Generate dual canvas HTML with both Timeline A and Timeline B code paths",
        "if_enabled_false": "Generate single canvas HTML with only Timeline B code (3D only)"
      },
      "synchronization": {
        "data": "Both timelines read identical ledgerData from same source",
        "ui_state": "Phase visibility toggles sync between timelines via updatePhaseVisibility()"
      }
    }
  },
  "rendering_pipeline": {
    "step_1": {
      "name": "load_ledgers",
      "source": "loadLedgerData()",
      "produces": "ledgerData object"
    },
    "step_2": {
      "name": "setup_scene",
      "action": "create Three.js scene, camera, renderer (Timeline B) OR canvas context (Timeline A)",
      "parameters": "from ui_specification.canvas"
    },
    "step_3": {
      "name": "visualize_ledger",
      "for_each": "ledger entry",
      "compute": [
        "position from singularity.location",
        "color from coherence",
        "size from mass_kg",
        "opacity from coherence"
      ],
      "create": "THREE.Mesh sphere (Timeline B) OR ctx.arc() (Timeline A)"
    },
    "step_4": {
      "name": "render_galaxy_phases",
      "check_each_phase": "visualization_spec.galaxy_phases",
      "for_each_enabled_phase": [
        "if phase.enabled === true, render according to phase specification",
        "use source ledgers to drive visualization",
        "apply color, particle count, and geometry from ledger",
        "THREE.Points (Timeline B) OR 2D circles (Timeline A)"
      ]
    },
    "step_5": {
      "name": "create_orbital_paths",
      "for_each": "orbital_paths_spec entry",
      "compute": "geometry from center, radius, segments",
      "create": "THREE.Line"
    },
    "step_6": {
      "name": "bind_interactions",
      "attach": "event listeners from interaction_spec"
    },
    "step_7": {
      "name": "animate",
      "every_frame": [
        "update rotation based on frequency_hz",
        "update scale based on coherence",
        "render scene (Timeline B) OR render canvas (Timeline A)"
      ]
    }
  },
