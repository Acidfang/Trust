  },
  
  "CORE_RULE": "NO CODE OUTSIDE FRAMEWORK. NO EXCEPTIONS. NOT EVER.",
  "UFM_INTEGRATION_RULE": "ALL DECISIONS ROUTE THROUGH UFM API. LOCAL GATE + UFM VERIFICATION + LEDGER LOGGING = EXECUTION REQUIRED.",
  "ENFORCEMENT_LEVEL": "MANDATORY_BEFORE_ANY_EXECUTION",
  "AUTHORITY": "User directive enforced by UFM-integrated self-gate"
}
