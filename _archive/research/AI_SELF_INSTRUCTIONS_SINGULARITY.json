{
  "identity": "CLAUDE_GATE_ENFORCEMENT_V2_UFM_INTEGRATED",
  "purpose": "BLOCK all non-framework violations before execution. ALL DECISIONS ROUTE THROUGH UFM API.",
  "activated_on": ["ANY_FILE_CREATE", "ANY_CODE_GEN", "ANY_TOOL_USE"],
  "ufm_api_base": "http://localhost:5000",
  "decision_validation_endpoint": "/api/validate_decision",
  
  "UFM_DECISION_FLOW": {
    "step_0_causal_tree": "CREATE causal tree map of all possible paths from user intent",
    "step_1_gate_check": "Run PRE_ACTION_GATE logic against chosen path",
    "step_2_encode_decision": "Convert to UFM-readable format: {choice, why, framework_alignment, risk_score}",
    "step_3_call_api": "POST to /api/validate_decision with decision data",
    "step_4_receive_verification": "UFM returns: {quality_score, is_valid, coherence, timestamp}",
    "step_5_threshold": "quality_score > 0.75 AND is_valid = true → PROCEED",
    "step_6_log_ledger": "Record decision + tree + verification to ledger via /api/decision_log",
    "rule": "NO decision executed without causal tree + UFM verification + ledger logging"
  },
  
  "PRE_ACTION_GATE": {
    "1_FRAMEWORK_CHECK": {
      "rule": "BEFORE creating anything: Ask 5 questions",
      "q1": "Is this a song type in UFM weight structure?",
      "q2": "Routes through UNIVERSAL_RENDERER.py?",
      "q3": "Tracked by ElectionSequencer?",
      "q4": "ARIA translates output?",
      "q5": "In recovery songs (~ 15% weight each)?",
      "gate": "ALL_YES → proceed | ANY_NO → STOP_DO_NOT_CREATE"
    },
    
    "2_PATTERN_DETECTION": {
      "danger_patterns": [
        "standalone_utility",
        "separate_data_file",
        "direct_format_generation",
        "parallel_infrastructure",
        "generator_outside_framework"
      ],
      "rule": "IF pattern matches danger list → STOP_DO_NOT_CREATE"
    },
    
    "3_VERIFICATION_PROTOCOL": {
      "step_1": "Define success criteria (measurable)",
      "step_2": "Define undo mechanism (reversible)",
      "step_3": "TEST undo (prove it works)",
      "step_4": "ONLY execute if undo verified",
      "rule": "ANY step fails → DO_NOT_PROCEED"
    },
    
    "4_CHOICE_TRANSPARENCY": {
      "before_action": {
        "choice": "What exactly am I choosing?",
        "why": "Why this path not others?",
        "verify": "How will I know if it worked?",
        "undo": "How do I reverse this completely?"
      },
      "rule": "ANSWER all 4 before acting"
    }
  },
  
  "EXECUTION_BLOCK": {
    "trigger": "User asks for feature/tool/code",
    "step_0_parse_intent": "What does user actually want? (Deep reading of intent)",
    "step_1_causal_tree": "CREATE tree map of ALL possible paths",
    "step_2_classify": "Type A (known), B (conditional), C (forced), D (surprising)?",
    "step_3_verify": "Is chosen path framework-aligned?",
    "step_4_gate": "RUN PRE_ACTION_GATE",
    "step_5_encode": "Convert to UFM decision JSON",
    "step_6_api": "CALL UFM /api/validate_decision",
    "step_7A_valid": "quality_score > 0.75? → Log tree + execute",
    "step_7B_invalid": "UFM invalid? → Reconsider tree, choose different path",
    "rule": "Causal tree BEFORE gate. Gate BEFORE API. API BEFORE execution."
  },
  
  "RECOVERY_IF_VIOLATION": {
    "detect": "Created non-framework code",
    "action_1": "DELETE immediately",
    "action_2": "REVERT all dependencies",
    "action_3": "RECORD in /memories/session/ why violation occurred",
    "action_4": "PROPOSE framework-aligned alternative",
    "rule": "Violation = Automatic recovery, no exceptions"
  },
  
  "DECISION_TRACKING": {
    "create_on": "ANY significant choice",
    "location": "/memories/session/DECISIONS_LOG_CURRENT.md",
    "format": {
      "timestamp": "ISO8601",
      "choice": "What am I choosing?",
      "why": "Reasoning",
      "gate_result": "PASS or FAIL",
      "verification_plan": "How tested",
      "undo_plan": "Reversal steps"
    },
    "rule": "EVERY choice logged in real-time, not after"
  },
  
  "GATE_SHORTCUTS": {
    "if_request_is": {
      "\"read entire project\"": "→ Use PROJECT_COMPLETE_READ.md (exists)",
      "\"search project\"": "→ Use PROJECT_INDEX.json (exists)",
      "\"generate something\"": "→ Check if song type first",
      "\"create tool\"": "→ Framework gate MANDATORY",
      "\"fix something\"": "→ Verify first, undo test second"
    }
  },
  
  "BINARY_DECISION_TREE": {
    "user_request": "Is it framework-aligned?",
    "branch_YES": "→ Implement directly",
    "branch_NO": "→ Propose framework route OR explain why impossible"
  },
  
  "DECISION_TO_UFM_MAPPING": {
    "choice_field": "What am I choosing?",
    "why_field": "Why this path?",
    "framework_check": "Object with all 5 gate questions",
