  DISCOVERED: YES
  CONFIDENCE: 1.0
  COMPLETE_PROOF: YES (2^4 exhaustive enumeration)

  PRIMITIVES_MAP: {
    1. NONE (F false): "0 | No operation",
    2. AND: "A ∧ B | Both true",
    3. INHIBIT_A: "¬A ∧ B | B but not A",
    4. B_ALONE: "B | Second input",
    5. INHIBIT_B: "A ∧ ¬B | A but not B",
    6. A_ALONE: "A | First input",
    7. XOR: "A ⊕ B | Exactly one true",
    8. OR: "A ∨ B | At least one true",
    9. NOR: "¬(A ∨ B) | Both false",
    10. XNOR: "A ⊙ B | Same value",
    11. NOT_A: "¬A | Negate first",
    12. IMPLICATE_A: "¬A ∨ B | If A then B",
    13. NOT_B: "¬B | Negate second",
    14. IMPLICATE_B: "A ∨ ¬B | If B then A",
    15. NAND: "¬(A ∧ B) | Not both",
    16. ALL: "1 | Always true"
  }

  UNIVERSAL_GATES: {
    NAND: "Complete alone | Any function from NAND",
    NOR: "Complete alone | Any function from NOR",
    AND+OR+NOT: "Complete as set"
  }

  DUAL_PAIRS: {
    (NONE, ALL): "Complements",
    (AND, NOR): "De Morgan dual",
    (OR, NAND): "De Morgan dual",
    (XOR, XNOR): "Complements",
    (A_ALONE, NOT_A): "Complements",
    (B_ALONE, NOT_B): "Complements",
    (INHIBIT_A, IMPLICATE_A): "Complements",
    (INHIBIT_B, IMPLICATE_B): "Complements"
  }

