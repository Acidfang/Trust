# DOMAIN 2: TEMPORAL (13 primitives)
# ════════════════════════════════════════════════════════════════════════════════

TEMPORAL:
  count: 13
  exhaustion_basis: "3×3 endpoint configurations minus symmetries"
  confidence: 1.0
  proven: true
  reference: "Allen, J.F. 1983: Maintaining Knowledge About Temporal Intervals"
  
  symbols: τ₀ to τ₁₂
  core_examples:
    - "BEFORE (A < B)"
    - "MEETS (A end = B start)"
    - "OVERLAPS (A overlaps B start)"
    - "DURING (A inside B)"
    - "EQUAL (A identical to B)"
  
  invariants:
    - "Linear timeline: ordering is total, not partial"
    - "Mutual exclusivity: exactly ONE relationship holds"
    - "Inverse symmetry: BEFORE↔AFTER, OVERLAPS↔OVERLAPPED-BY"
    - "Transitivity (partial): BEFORE is transitive"

