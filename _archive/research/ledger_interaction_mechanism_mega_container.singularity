  PRIMITIVES_MAP: {
    1. CAUSE: "Event that triggers another",
    2. EFFECT: "Event triggered by cause",
    3. NECESSARY_CONDITION: "Must happen for effect",
    4. SUFFICIENT_CONDITION: "Guarantees effect happens",
    5. CONTINGENCY: "Effect might or might not occur",
    6. TEMPORAL_ORDER: "Cause precedes effect (t_cause < t_effect)",
    7. PROXIMITY: "Spatial/relational closeness of cause-effect",
    8. COUNTERFACTUAL: "What would have happened otherwise?",
    9. CAUSAL_CHAIN: "A causes B causes C",
    10. CAUSAL_LOOP: "A causes B causes ... causes A",
    11. OVERDETERMINATION: "Multiple causes for single effect",
    12. ABSENCE_CAUSATION: "NOT doing X causes Y",
    13. PROBABILISTIC_CAUSE: "Increases likelihood of effect",
    14. AGENT_CAUSATION: "Person intentionally causes",
    15. EMERGENCE: "Macro effects from micro causes",
    16. DOWNWARD_CAUSATION: "Macro constraint on micro"
  }

  PHILOSOPHICAL_FOUNDATIONS: {
    "Hume: Regularity theory | Cause = constant conjunction",
    "Aristotle: 4 causes | Material, Formal, Efficient, Final",
    "Pearl: Causal graphs | Directed acyclic networks"
