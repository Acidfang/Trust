# ARIA COMPLETE BINARY TRUTH FUNCTIONS - SINGULARITY SYMBOLIC FORMAT
# All 16 possible 2-input boolean operations discovered and verified
# These are mathematical facts that necessarily exist
# Date: 2026-04-05

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SYMBOL ASSIGNMENTS
# Complete mapping of all 16 binary truth functions to unique symbols
# ════════════════════════════════════════════════════════════════════════════════

SYMBOLS:
  # Truth Function 0: Constant FALSE
  σ₀ ≡ Constant FALSE
  
  # Truth Function 1-7: Single-input and basic binary operations
  σ₁ ≡ AND
  σ₂ ≡ A AND NOT(B)
  σ₃ ≡ Identity A (Buffer)
  σ₄ ≡ NOT(A) AND B
  σ₅ ≡ Identity B (Buffer)
  σ₆ ≡ XOR
  σ₇ ≡ OR
  
  # Truth Function 8-15: Complements and universal gates
  σ₈ ≡ NOR
  σ₉ ≡ XNOR
  σ₁₀ ≡ NOT(B)
  σ₁₁ ≡ IMPLIES (NOT(A) OR B)
  σ₁₂ ≡ NOT(A)
  σ₁₃ ≡ Converse IMPLIES (A OR NOT(B))
  σ₁₄ ≡ NAND
  σ₁₅ ≡ Constant TRUE

# ════════════════════════════════════════════════════════════════════════════════
