# USER PERSPECTIVE SPECIFICATION - PURE SYMBOLIC
# What system needs to track about the user for personalization and understanding
# Universal specification - never changes during runtime
# Date: 2026-03-27
# Format: Pure symbolic notation, no runtime data, no comments in content

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SYMBOLS
# ════════════════════════════════════════════════════════════════════════════════

SYMBOLS:
  u_stmt ≡ user:statement
  u_pat ≡ user:pattern
  u_intent ≡ user:intention
  u_pref ≡ user:preference
  u_hist ≡ user:interaction_history
  u_sat ≡ user:satisfaction

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER PERSPECTIVE PRIMITIVES
# ════════════════════════════════════════════════════════════════════════════════

PRIMITIVES:

  u_stmt: ⊙ → β[archived] → κ⊕[statement_text, context, category] → λ[user_explicit_need] → Θ[record] → τ[variable]
    fields: timestamp, user_statement, context, category
    updatable: false (immutable record)

  u_pat: ⊙ → β[observed|verified] → κ⊕[pattern_name, observations, current_assessment] → λ[pattern] → Θ[learn] → τ[variable]
    fields: pattern_id, description, observations[], current_value
    updatable: true (observations grow)

  u_intent: ⊙ → β[uncertain|confident] → κ⊕[intention_description, confidence, evidence] → λ[user_deep_need] → Θ[interpret] → τ[variable]
    fields: intention_id, description, confidence[0.0-1.0], evidence[]
    updatable: true (confidence and evidence grow)

  u_pref: ⊙ → β[unknown|inferred] → κ⊕[preference_value, confidence, reason] → λ[preference] → Θ[personalize] → τ[variable]
    fields: preference_id, description, current_value, confidence[0.0-1.0], reason
    updatable: true (confidence grows)

  u_hist: ⊙ → β[recorded] → κ⊕[timestamp, action, context, result] → λ[interaction] → Θ[remember] → τ[variable]
    fields: timestamp, source, button_id, meaning, intent
    updatable: false (immutable history)

  u_sat: ⊙ → β[unknown|measured] → κ⊕[satisfaction_indicators, current_level] → λ[satisfaction] → Θ[respond] → τ[variable]
    fields: indicator_type, measurements[], current_satisfaction
    updatable: true (measurements accumulate)

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER STATEMENT ARCHIVE SPEC
# ════════════════════════════════════════════════════════════════════════════════

USER_STATEMENT_SPEC:

  u_stmt tracks every explicit user request:
    - timestamp: when user expressed this need
    - user_statement: exact or paraphrased request
    - context: what was user trying to do?
    - category: system_operation | configuration | information | help

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER PATTERN DISCOVERY SPEC
# ════════════════════════════════════════════════════════════════════════════════

USER_PATTERN_SPEC:

  u_pat:preferred_view:
    description: "Which views does user prefer to use?"
    possible_values: [menu, live_elections, timeline_visualization, utility_landscape]
    learnable: true

  u_pat:session_length:
    description: "How long does user typically interact per session?"
    possible_values: minutes (continuous)
    learnable: true

  u_pat:interaction_style:
    description: "Is user deliberate, exploratory, or goal-driven?"
    possible_values: [deliberate, exploratory, goal_driven]
    learnable: true

  u_pat:response_speed:
    description: "How quickly does user issue next command after result?"
    possible_values: seconds (continuous)
    learnable: true

  u_pat:error_tolerance:
    description: "How does user react to system errors or delays?"
    possible_values: [high_tolerance, medium_tolerance, low_tolerance]
    learnable: true

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER INTENTION INTERPRETATION SPEC
# What deep needs does the user have beyond explicit requests?
# ════════════════════════════════════════════════════════════════════════════════

USER_INTENTION_SPEC:

  u_intent:visibility_control:
    description: "User wants to control what's visible on screen"
    confidence_range: [0.0, 1.0]
    evidence_sources: [button_clicks, interaction_patterns]

  u_intent:navigation:
    description: "User wants to move between different system views"
    confidence_range: [0.0, 1.0]
    evidence_sources: [button_clicks, view_transitions]

  u_intent:exploration:
    description: "User wants to understand what the system can do"
    confidence_range: [0.0, 1.0]
    evidence_sources: [random_clicking, all_buttons_tried, frequent_returns]

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER PREFERENCE INFERENCE SPEC
# What settings would improve user experience?
# ════════════════════════════════════════════════════════════════════════════════

USER_PREFERENCE_SPEC:

  u_pref:sidebar_default_state:
    description: "Should sidebar default open or closed?"
    possible_values: [open, closed]
    confidence_range: [0.0, 1.0]
    learnable: true

  u_pref:interaction_speed:
    description: "Does user prefer fast animations or leisurely transitions?"
    possible_values: [fast, medium, slow]
    confidence_range: [0.0, 1.0]
    learnable: true

  u_pref:information_density:
    description: "Does user prefer minimalist or information-rich interface?"
    possible_values: [minimalist, balanced, information_rich]
    confidence_range: [0.0, 1.0]
    learnable: true

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: INTERACTION HISTORY SPEC
# Complete timeline of user actions (immutable record)
# ════════════════════════════════════════════════════════════════════════════════

USER_INTERACTION_SPEC:

  u_hist tracks:
    - session_count: number of distinct user sessions
    - total_interactions: total actions user has taken
    - timeline: append-only log of all interactions
    - format: timestamp | source | button | meaning | intent

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SATISFACTION TRACKING SPEC
# How well is system serving the user?
# ════════════════════════════════════════════════════════════════════════════════

USER_SATISFACTION_SPEC:

  u_sat tracks via indicators:

  indicator:interaction_frequency:
    description: "More interactions = more satisfied (usually)"
    direction: positive (more is better)

  indicator:action_success_rate:
    description: "Did user's action produce expected result?"
    direction: positive (higher is better)

  indicator:repeat_commands:
    description: "Does user repeat same command? (might indicate confusion)"
    direction: negative (lower is better)

  indicator:error_recovery:
    description: "How quickly does user recover from errors?"
    direction: positive (faster is better)

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SESSION CONTEXT SPEC
# Information to remember for user's next visit
# ════════════════════════════════════════════════════════════════════════════════

USER_CONTEXT_SPEC:

  session_context tracks:
    - last_view: which dashboard was user last viewing?
    - last_timestamp: when did user leave?
    - last_preference: what was user's recent preference setting?
    - likely_next_action: system's prediction of what user will do next
    - context_notes: narrative notes about user's session pattern

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: INTEGRITY CONSTRAINTS
# ════════════════════════════════════════════════════════════════════════════════

INTEGRITY:

  all_statements_timestamped: every u_stmt has timestamp
  all_statements_immutable: u_stmt entries never change after recording
  all_patterns_named: every u_pat has unique pattern_id
  all_intentions_named: every u_intent has unique intention_id
  all_preferences_named: every u_pref has unique preference_id
  all_history_immutable: u_hist entries never change after recording
  all_confidence_bounded: all u_intent and u_pref confidence in [0.0, 1.0]
  causality_traceable: patterns derived from history, intentions from patterns

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: VERIFICATION GATES
# ════════════════════════════════════════════════════════════════════════════════

VERIFICATION:

  gate_1_alignment:
    question: "Does user perspective spec match what system observes?"
    verification: symbols ↔ observable user behaviors
    status: DEFINED

  gate_2_eliminates_ambiguity:
    question: "Is every aspect of user understanding uniquely defined?"
    verification: no overlap in pattern/intention/preference categories
    status: DEFINED

  gate_3_reasoning_visible:
    question: "Can you trace user understanding from spec to data?"
    verification: history → pattern → intention → preference → personalization
    status: DEFINED

  gate_4_is_it_kind:
    question: "Does tracking user perspective improve system?"
    verification: enables personalization and better user experience
    status: DEFINED

  gate_5_does_it_scale:
    question: "Works with 1 user or 1,000,000 users?"
    verification: append-only history, learnable patterns
    status: DEFINED

# ════════════════════════════════════════════════════════════════════════════════
# EOF: User Perspective Specification Complete
# This file contains ONLY what system needs to track about user
# Runtime data (what system actually observed) is in ledger_instance_user_perspective.singularity
# ════════════════════════════════════════════════════════════════════════════════
