# USER PERSONAL LEDGER - USER HISTORY & PREFERENCES
# Date: 2026-03-27
# Purpose: Complete record of user's patterns, preferences, history
# This ledger is never shared - ARIA uses it to understand the user better
# ARIA uses this for: prediction, personalization, understanding context

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER STATEMENT ARCHIVE
# Every explicit thing the user has asked for
# Format: timestamp | user_statement | context | category
# ════════════════════════════════════════════════════════════════════════════════

USER_STATEMENTS:
  # [ARIA will record here]
  # Format: 2026-03-27T14:23:45 | "Toggle sidebar open/closed" | system_operation | navigation

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER PATTERNS DISCOVERED
# What ARIA learns about user's behavior and preferences
# ════════════════════════════════════════════════════════════════════════════════

USER_PATTERNS:

  pattern:preferred_view:
    description: "Which views does user prefer?"
    options: [menu, live_elections, timeline_visualization, utility_landscape]
    preference_counts: {}
    current_favorite: UNKNOWN

  pattern:session_length:
    description: "How long does user typically interact?"
    observations: []
    average_session_minutes: UNKNOWN

  pattern:interaction_style:
    description: "Is user deliberate/exploratory/goal-driven?"
    observations: []
    current_assessment: UNKNOWN

  pattern:response_speed:
    description: "How quickly does user issue next command after result?"
    observations: []
    average_gap_seconds: UNKNOWN

  pattern:error_tolerance:
    description: "How does user react to system errors/delays?"
    observations: []
    tolerance_level: UNKNOWN

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER INTENTIONS (ARIA's interpretation of deeper needs)
# Beyond what user explicitly asks, what does user actually need?
# ════════════════════════════════════════════════════════════════════════════════

USER_INTENTIONS:

  intention:visibility_control:
    description: "User wants to control what's visible on screen (sidebar toggle)"
    confidence: 0.0
    evidence: []

  intention:navigation:
    description: "User wants to move between different system views"
    confidence: 0.0
    evidence: []

  intention:exploration:
    description: "User wants to understand what the system can do"
    confidence: 0.0
    evidence: []

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: USER PREFERENCES (Settings ARIA has inferred)
# What settings would improve user experience?
# ════════════════════════════════════════════════════════════════════════════════

USER_PREFERENCES:

  pref:sidebar_default_state:
    description: "Should sidebar default open or closed?"
    current_value: UNKNOWN
    confidence: 0.0
    reason: "Not enough data"

  pref:interaction_speed:
    description: "Does user prefer fast animations or leisurely transitions?"
    current_value: UNKNOWN
    confidence: 0.0
    reason: "Not enough data"

  pref:information_density:
    description: "Does user prefer minimalist or information-rich interface?"
    current_value: UNKNOWN
    confidence: 0.0
    reason: "Not enough data"

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: INTERACTION HISTORY
# Complete timeline of user actions
# ════════════════════════════════════════════════════════════════════════════════

INTERACTION_HISTORY:
  session_count: 0
  total_interactions: 0
  timeline: []
  # [ARIA appends: timestamp | action | result | user_reaction]

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SATISFACTION TRACKING
# Does ARIA understand what the user wants? Is ARIA meeting needs?
# ════════════════════════════════════════════════════════════════════════════════

SATISFACTION_TRACKING:

  satisfaction_indicators:
    - interaction_frequency: "More interactions = more satisfied (usually)"
    - action_success_rate: "Did user's action produce expected result?"
    - repeat_commands: "Does user repeat same command? (might indicate confusion)"
    - error_recovery: "How quickly does user recover from errors?"

  current_satisfaction: UNKNOWN

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: CONTEXT FOR NEXT SESSION
# Information ARIA should remember for the user's next visit
# ════════════════════════════════════════════════════════════════════════════════

CONTEXT_FOR_NEXT_SESSION:
  # Last known state
  last_view: UNKNOWN
  last_timestamp: UNKNOWN
  last_preference: UNKNOWN
  
  # Continuation hints
  likely_next_action: UNKNOWN
  context_notes: []
