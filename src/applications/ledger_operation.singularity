# OPERATION LEDGER - MINIMAL EXECUTABLE SPECIFICATION
# Date: 2026-03-27
# Purpose: ONLY what ARIA needs to operate the app
# This ledger is read every interaction cycle
# Everything here must translate directly to app behavior

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: SYMBOLS (Identity mapping)
# ════════════════════════════════════════════════════════════════════════════════

SYMBOLS:
  α ≡ btn:toggle-sidebar        # Menu toggle button
  β ≡ menu_expanded             # Menu expansion state (0=collapsed, 1=expanded)
  γ ≡ canvas_3d_bg              # Background color
  δ ≡ menu_item_visible         # Menu item visibility (0=hidden, 1=visible)
  ε ≡ current_view              # Current view
  ζ ≡ btn:live-elections        # Live elections button
  η ≡ btn:timeline-dag          # Timeline DAG button
  θ ≡ btn:utilities             # Utilities button
  ι ≡ btn:back                  # Back button
  κ ≡ btn:coherence-monitoring  # Coherence monitoring button
  λ ≡ btn:synthesis-progress    # Synthesis progress button
  μ ≡ btn:learning-curve        # Learning curve button
  ν ≡ btn:timeline-records      # Timeline records button
  ξ ≡ header_height             # Header height
  ο ≡ button_height             # Button height

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: STATE (Current values)
# ════════════════════════════════════════════════════════════════════════════════

STATE:
  β = 1                          # menu_expanded: 0=collapsed, 1=expanded
  ε = live_elections                          # current_view
  γ =                           #000000                    # canvas background
  δ = 1                          # menu_item_visible: 0=hidden, 1=visible

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: INTENT → ACTION RULES
# Format: meaning + intent → state_update
# These are the ONLY executable rules. Everything else is metadata.
# ════════════════════════════════════════════════════════════════════════════════

RULES:

  # TOGGLE meaning: User wants to collapse/expand menu dropdown
  toggle + alpha → β' = ¬β
    meaning: toggle
    intent: [collapse_expand_menu_dropdown]
    action: β = ¬β; δ = β; render()
    
  # NAVIGATE meaning: User wants to go to a view
  navigate + zeta → ε' = live_elections
    meaning: navigate
    intent: [navigate_to_live_elections]
    action: ε = live_elections; render()

  navigate + eta → ε' = timeline_visualization
    meaning: navigate
    intent: [navigate_to_timeline_dag]
    action: ε = timeline_visualization; render()

  navigate + theta → ε' = utility_landscape
    meaning: navigate
    intent: [navigate_to_utilities]
    action: ε = utility_landscape; render()

  navigate + iota → ε' = menu
    meaning: navigate
    intent: [navigate_back_to_menu]
    action: ε = menu; render()

  navigate + kappa → ε' = coherence_monitoring
    meaning: navigate
    intent: [navigate_to_coherence_monitoring]
    action: ε = coherence_monitoring; render()

  navigate + lambda → ε' = synthesis_progress
    meaning: navigate
    intent: [navigate_to_synthesis_progress]
    action: ε = synthesis_progress; render()

  navigate + mu → ε' = learning_curve
    meaning: navigate
    intent: [navigate_to_learning_curve]
    action: ε = learning_curve; render()

  navigate + nu → ε' = timeline_records
    meaning: navigate
    intent: [navigate_to_timeline_records]
    action: ε = timeline_records; render()

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: CAUSAL CHAINS (How state flows to rendering)
# ════════════════════════════════════════════════════════════════════════════════

CAUSAL_CHAINS:

  β → δ:
    if β = 0: δ = 0    # Menu collapsed = items hidden
    if β = 1: δ = 1    # Menu expanded = items visible
    effect: menu items positioned below toggle button when β=1

  δ → rendering:
    if δ = 0: menu_items.y = -500 (off-screen)
    if δ = 1: menu_items.y = 100 (below toggle button, relative to button origin)
    effect: menu items flow down from toggle button when expanded

  ε → rendering:
    always: frame_for_view(ε) called
    effect: correct view content displayed

