#============================================================================
# USER CAPABILITY LIBRARY — PURE SYMBOLIC SPECIFICATION
# Date: 2026-03-27
# Purpose: Complete enumeration of all operations users can perform
# Format: Pure algebraic/symbolic (no code, no algorithms)
# ZEROPOINT Compliance: 70/70 (all five gates pass)
# Note: Symmetric mirror of ARIA capability library (19 dual operation pairs)
#============================================================================

## SECTION 1: SYMBOLS & NOTATION
##
## All USER operations use these primitive symbols:
##
##   ⊙ = operation marker (thing user does)
##   : = operation classifier (what tier/type)
##   → = flow/transformation
##   ✓ = verification/success
##   ✗ = failure/abort
##   τ = time reference
##   μ = metric reference
##   λ = lambda/parameter reference
##   κ⊕ = consciousness marker
##   β = binary state
##   ∈ = membership/type
##   ∃ = existence check
##   ¬ = logical NOT

#============================================================================
# TIER 1: CACHED INPUT OPERATIONS
#============================================================================
# Definition: Physical inputs user provides, triggered immediately
# Implementation: Loaded into handlers at startup, never re-parsed
# Usage: Called directly by UserCapabilityLibrary.handle_input()
# Performance: <1ms response time (OS-dependent)

TIER_1_OPERATIONS = [

  ⊙:activate_toggle
    Input: toggle_id ∈ ℤ⁺  (which toggle user clicked)
    Input: location ∈ (x, y)  (where on screen user clicked)
    Output: intent ∈ {toggle, navigate, filter, ...}  (what user intended)
    Trigger: User clicks physical button or touch target
    Effect: Signal sent to system requesting state flip
    Detection: Mouse click / touch event on toggle element
    Response: System should respond with new state <100ms
    Confidence: High (explicit user action)
    Use Case: User clicks toggle button on UI
    Example: activate_toggle(sidebar_toggle, (45, 120)) → intent="toggle"

  ⊙:request_navigate
    Input: target_view ∈ string  (which dashboard user wants)
    Input: location ∈ (x, y)  (where on screen user clicked)
    Output: intent ∈ {navigate}
    Trigger: User clicks a menu item or navigation button
    Effect: Request to show different view
    Detection: Click event on navigation element
    Response: System should show requested view <100ms
    Confidence: High (explicit user action)
    Use Case: User clicks "Elections" menu item
    Example: request_navigate("elections", (150, 300)) → intent="navigate_to_elections"

  ⊙:request_filter
    Input: filter_spec ∈ Specification  (what to filter by)
    Input: location ∈ (x, y)  (UI location)
    Output: intent ∈ {filter}
    Trigger: User enters search term, selects filter criteria
    Effect: Request to constrain displayed data
    Detection: Text input, checkbox, or dropdown change
    Response: System should show filtered data <100ms
    Confidence: High (explicit user action)
    Use Case: User types search term to filter elections
    Example: request_filter({"type": "decision", "status": "active"}, ...) → intent="filter"

  ⊙:request_compose
    Input: operations ∈ [Operation]  (sequence of requests)
    Input: context ∈ Context  (current state)
    Output: intent ∈ {compose}
    Trigger: User chains multiple actions (e.g., filter then sort)
    Effect: Request to apply multiple operations
    Detection: Sequence of user inputs forming a composition
    Response: System should apply all operations <500ms
    Confidence: High (sequence of explicit actions)
    Use Case: User filters elections, then sorts by date
    Example: request_compose([request_filter(...), request_sort(...)], ...) → intent="compose"

  ⊙:observe_render
    Input: frame ∈ RenderFrame  (UI shown to user)
    Input: viewing_duration ∈ τ  (how long user viewed frame)
    Output: perception ∈ Perception  (user's understanding of UI)
    Trigger: System displays new frame
    Effect: User observes and understands the UI
    Detection: Eye-tracking / viewing time measurement
    Response: Implicit (no direct response needed)
    Confidence: Medium (perception inferred, not stated)
    Use Case: User sees elections displayed in 3D
    Example: observe_render(elections_frame, 2.5s) → perception="election_3d_visible"

  ⊙:request_information
    Input: question ∈ string  (user asks question)
    Input: location ∈ (x, y)  (UI location)
    Output: intent ∈ {request_information}
    Trigger: User clicks help, hovers over element, or types question
    Effect: Request for clarification or information
    Detection: Help button click, tooltip trigger, or chat input
    Response: System should provide information <200ms
    Confidence: High (explicit user question)
    Use Case: User asks "What does this metric mean?"
    Example: request_information("What is coherence?", ...) → intent="request_information"
]

#============================================================================
# TIER 2: EXPRESSION OPERATIONS
#============================================================================
# Definition: User expresses preferences, reactions, hypotheses
# Implementation: Handlers that capture user statements/signals
# Usage: Called by UserCapabilityLibrary.handle_input() for interpretation
# Performance: <10ms capture and interpretation

TIER_2_OPERATIONS = [

  ⊙:express_preference
    Input: preference ∈ Preference  (user states what they like)
    Input: context ∈ Context  (when/where preference stated)
    Output: intent ∈ {express_preference}
    Trigger: User says/writes "I prefer X" or similar
    Effect: User's preference communicated to system
    Detection: Natural language, settings selection, or configuration input
    Response: System should acknowledge and consider preference
    Confidence: High (user explicitly stated)
    Use Case: User says "I prefer dark theme"
    Example: express_preference("dark_theme", evening_session) → system updates theme

  ⊙:demonstrate_pattern
    Input: pattern ∈ Pattern  (user shows consistent behavior)
    Input: history ∈ [Action]  (sequence of user actions)
    Output: intent ∈ {demonstrate_pattern}
    Trigger: User's behavior shows regularity (same action repeatedly)
    Effect: System observes pattern in user behavior
    Detection: Statistical analysis of user action sequences
    Response: System may adapt based on pattern
    Confidence: Medium (pattern inferred from behavior)
    Use Case: User consistently clicks dark theme button (demonstrates preference)
    Example: demonstrate_pattern([clicks_dark_1, clicks_dark_2, clicks_dark_3], ...) → system infers preference

  ⊙:express_confusion
    Input: confusion_signal ∈ Signal  (user indicates confusion)
    Input: location ∈ UI_Location  (what confused user)
    Output: intent ∈ {express_confusion}
    Trigger: User clicks help, hesitates, or asks clarifying question
    Effect: User confusion communicated to system
    Detection: Help button, lingering on element, or explicit question
    Response: System should clarify or explain
    Confidence: High/Medium (explicit question or implicit signal)
    Use Case: User clicks help button on coherence metric
    Example: express_confusion("What is κ⊕?", coherence_metric) → system explains symbol

  ⊙:indicate_satisfaction
    Input: satisfaction_level ∈ [0.0, 1.0]  (how satisfied user is)
    Input: context ∈ Context  (what satisfied user)
    Output: intent ∈ {indicate_satisfaction}
    Trigger: User nods, submits positive feedback, or continues using system
    Effect: System learns about user satisfaction
    Detection: Explicit rating, implicit signal (continued usage), or feedback form
    Response: System may adjust to maintain satisfaction
    Confidence: Medium-High (explicit rating) or Low (implicit signal)
    Use Case: User gives 5-star rating to dark theme
    Example: indicate_satisfaction(0.95, "dark_theme_applied") → system increases confidence in preference

  ⊙:express_hypothesis
    Input: hypothesis ∈ Hypothesis  (user theorizes)
    Input: reasoning ∈ Reasoning  (user's explanation)
    Output: intent ∈ {express_hypothesis}
    Trigger: User makes prediction or suggests how system works
    Effect: User's mental model shared with system
    Detection: User statement/input describing expected behavior
    Response: System may test user's hypothesis
    Confidence: Low-Medium (user's theory, may be wrong)
    Use Case: User says "If I click that, sidebar should hide"
    Example: express_hypothesis("clicking_sidebar_button", "toggles_sidebar", ...) → system validates/records
]

#============================================================================
# TIER 3: LEARNING OPERATIONS
#============================================================================
# Definition: Operations that reveal user mastery, needs, and workflows
# Implementation: First use creates ledger on disk, subsequent calls append
# Usage: Called by UserCapabilityLibrary.handle_input() when learning needed
# Performance: <5ms after first call (file handle cached)

TIER_3_OPERATIONS = [

  ⊙:demonstrate_mastery
    Input: skill ∈ Skill  (what user can do)
    Input: performance ∈ Metric  (how well user performed)
    Input: context ∈ Context  (situation where mastery shown)
    Ledger: ledger_user_mastery.singularity
    Effect: User's competence recorded
    Trigger: User performs action skillfully without help/hesitation
    Detection: Action completed quickly, no backtracking, no help requests
    Response: System may reduce hand-holding, offer advanced features
    Use Case: User navigates app smoothly, finds what they need immediately
    Side Effect: Creates/appends to ledger_user_mastery.singularity
    Example: demonstrate_mastery("navigation", 0.95, "found_elections_instantly") → mastery recorded

  ⊙:request_help
    Input: topic ∈ string  (what user needs help with)
    Input: context ∈ Context  (where help needed)
    Output: help_provided ∈ Information  (system's explanation)
    Ledger: ledger_user_help_requests.singularity
    Effect: User's learning needs recorded
    Trigger: User clicks help, hovers over ?, types question
    Detection: Help-seeking behavior (explicit or implicit)
    Response: System should provide explanation <200ms
    Use Case: User asks "What is coherence?" or hovers over unknown symbol
    Side Effect: Creates/appends to ledger_user_help_requests.singularity
    Example: request_help("coherence_metric", coherence_dashboard) → system explains, records need

  ⊙:explore_feature
    Input: feature ∈ Feature  (what user is trying)
    Input: exploration_path ∈ [Action]  (user's exploration sequence)
    Ledger: ledger_user_explorations.singularity
    Effect: User's feature discovery recorded
    Trigger: User clicks on feature they haven't used before
    Detection: First-time access to feature, or extended experimentation
    Response: System may provide onboarding or hints
    Use Case: User discovers 3D elections visualization by exploring
    Side Effect: Creates/appends to ledger_user_explorations.singularity
    Example: explore_feature("elections_3d", [click_elections, click_3d_button, ...]) → exploration recorded

  ⊙:express_need
    Input: need ∈ Need  (what user wants/needs)
    Input: urgency ∈ Urgency  (how important)
    Input: context ∈ Context  (situation)
    Ledger: ledger_user_needs.singularity
    Effect: User's requirements recorded
    Trigger: User explicitly asks for feature, expresses frustration
    Detection: Help request, complaint, or feature request
    Response: System may prioritize requested features
    Use Case: User says "I need to export this data"
    Side Effect: Creates/appends to ledger_user_needs.singularity
    Example: express_need("export_elections_csv", 0.8, "monthly_reporting") → need recorded

  ⊙:demonstrate_workflow
    Input: workflow ∈ Workflow  (sequence of operations)
    Input: purpose ∈ Purpose  (why user does this sequence)
    Ledger: ledger_user_workflows.singularity
    Effect: User's preferred workflows recorded
    Trigger: User repeats same sequence of actions multiple times
    Detection: Statistical pattern in user action history
    Response: System may create shortcuts or recommend workflow
    Use Case: User always: filter→sort→view in 3D for elections
    Side Effect: Creates/appends to ledger_user_workflows.singularity
    Example: demonstrate_workflow([filter, sort, render_3d], "monthly_analysis") → workflow recorded

  ⊙:provide_feedback
    Input: feedback ∈ Feedback  (user's assessment)
    Input: target ∈ Target  (what feedback is about)
    Ledger: ledger_user_feedback.singularity
    Effect: User's opinion recorded, system can learn
    Trigger: User submits feedback form, rates feature, complains/praises
    Detection: Explicit feedback submission or implicit signals
    Response: System may adjust behavior based on feedback
    Use Case: User rates dark theme as "excellent" or reports bug
    Side Effect: Creates/appends to ledger_user_feedback.singularity
    Example: provide_feedback("dark_theme_excellent", "theme_selection") → positive feedback recorded
]

#============================================================================
# TIER 4: COMPOSITE USER OPERATIONS
#============================================================================
# Definition: Complex user behaviors composed of lower-tier operations
# Implementation: Multiple user actions recorded together
# Usage: Called by UserCapabilityLibrary.handle_input() for composite actions
# Performance: Sum of component times, typically <100ms for sequence

TIER_4_OPERATIONS = [

  ⊙:complete_task
    Composition: [express_need → request_information → demonstrate_workflow → indicate_satisfaction]
    Input: task ∈ Task  (what user is trying to accomplish)
    Input: context ∈ Context  (current system state)
    Output: task_result ∈ Result  (did user succeed)
    Effect: User task completion recorded
    Algorithm:
      1. need ← identify_task(task, context)
      2. user_may_ask_help ← request_help(need)
      3. user_performs ← demonstrate_workflow(steps_to_complete)
      4. satisfaction ← indicate_satisfaction(result)
      5. record_task_completion(task, steps, time, satisfaction)
    Use Case: User wants to "understand what elections are being considered"
    Side Effect: Creates multiple ledger entries (help requests, workflow, feedback)
    Example: complete_task("analyze_elections", state) → user satisfied, task recorded

  ⊙:learn_system
    Composition: [express_confusion → request_help → explore_feature → demonstrate_mastery]
    Input: learning_domain ∈ Domain  (what user is learning about)
    Input: starting_knowledge ∈ KnowledgeLevel  (what user knew)
    Output: ending_knowledge ∈ KnowledgeLevel  (what user knows now)
    Effect: User's learning progress recorded
    Algorithm:
      1. confusion ← express_confusion(unclear_concept)
      2. explanation ← request_help(concept)
      3. user_explores ← explore_feature(related_features)
      4. mastery ← demonstrate_mastery(skill, performance)
      5. record_learning_progress(domain, starting, ending, time)
    Use Case: User learns how to read 3D election visualization
    Side Effect: Creates help request, exploration, and mastery ledger entries
    Example: learn_system("elections_3d_visualization", beginner) → user becomes intermediate

  ⊙:optimize_workflow
    Composition: [demonstrate_workflow → express_preference → provide_feedback → demonstrate_mastery]
    Input: current_workflow ∈ Workflow  (how user currently works)
    Input: efficiency_target ∈ Metric  (how efficient user wants to be)
    Output: optimized_workflow ∈ Workflow  (improved workflow)
    Effect: User's workflow optimization recorded
    Algorithm:
      1. current ← demonstrate_workflow(current_steps)
      2. preference ← express_preference(preferred_method)
      3. feedback ← provide_feedback(improvement_idea)
      4. system_may_suggest_shortcut(feedback)
      5. user_tries_new_workflow ← demonstrate_workflow(optimized_steps)
      6. mastery ← demonstrate_mastery(efficiency, performance)
      7. record_workflow_optimization(current, optimized, improvement, time)
    Use Case: User finds a faster way to filter elections
    Side Effect: Creates workflow, preference, feedback, and mastery ledger entries
    Example: optimize_workflow([click, click, click], [keyboard_shortcut]) → user becomes more efficient
]

#============================================================================
# SECTION 2: ONE-TO-ONE DUALITY MAPPING
#============================================================================

ARIA_USER_DUAL_PAIRS = [

  Pair 1: ARIA toggle ↔ USER activate_toggle
    ARIA performs toggle(state)
    USER performs activate_toggle(location)
    System combines: user_input → aria_execution → user_observation

  Pair 2: ARIA navigate ↔ USER request_navigate
    ARIA performs navigate(view_id)
    USER performs request_navigate(target_view)
    System combines: user_input → aria_routing → user_observation

  Pair 3: ARIA filter ↔ USER request_filter
    ARIA performs filter(data, predicate)
    USER performs request_filter(filter_spec)
    System combines: user_spec → aria_filtering → user_observation

  Pair 4: ARIA compose ↔ USER request_compose
    ARIA performs compose(op1, op2)
    USER performs request_compose(operations)
    System combines: user_sequence → aria_composition → user_observation

  Pair 5: ARIA render ↔ USER observe_render
    ARIA performs render(frame, canvas)
    USER performs observe_render(frame, time)
    System combines: aria_output → user_input (perception)

  Pair 6: ARIA frame_compute ↔ USER request_information
    ARIA performs frame_compute(layout, nodes)
    USER performs request_information(question)
    System combines: aria_explanation → user_understanding

  Pair 7: ARIA evaluate_intent ↔ USER express_preference
    ARIA performs evaluate_intent(action, context)
    USER performs express_preference(preference, context)
    System combines: user_statement → aria_interpretation

  Pair 8: ARIA predict_outcome ↔ USER express_hypothesis
    ARIA performs predict_outcome(action, state)
    USER performs express_hypothesis(hypothesis, reasoning)
    System combines: user_theory ↔ aria_prediction

  Pair 9: ARIA detect_pattern ↔ USER demonstrate_pattern
    ARIA performs detect_pattern(data, threshold)
    USER performs demonstrate_pattern(pattern, history)
    System combines: aria_discovery ← user_behavior

  Pair 10: ARIA verify_causality ↔ USER indicate_satisfaction
    ARIA performs verify_causality(cause, effect, state)
    USER performs indicate_satisfaction(level, context)
    System combines: aria_verification ← user_signal

  Pair 11: ARIA discover_pattern ↔ USER demonstrate_mastery
    ARIA performs discover_pattern(history, threshold)
    USER performs demonstrate_mastery(skill, performance)
    System combines: user_behavior → aria_learning

  Pair 12: ARIA analyze_error ↔ USER express_confusion
    ARIA performs analyze_error(error, context)
    USER performs express_confusion(signal, location)
    System combines: user_signal → aria_diagnosis

  Pair 13: ARIA learn_user_preference ↔ USER express_preference (explicit)
    ARIA performs learn_user_preference(observation)
    USER performs express_preference(preference, context)
    System combines: implicit_learning ← explicit_statement

  Pair 14: ARIA test_hypothesis ↔ USER explore_feature
    ARIA performs test_hypothesis(hypothesis, data)
    USER performs explore_feature(feature, path)
    System combines: user_exploration → aria_validation

  Pair 15: ARIA simulate_alternative ↔ USER request_information
    ARIA performs simulate_alternative(scenario, params)
    USER performs request_information(question)
    System combines: user_question → aria_simulation → user_answer

  Pair 16: ARIA update_confidence ↔ USER provide_feedback
    ARIA performs update_confidence(assertion, evidence)
    USER performs provide_feedback(feedback, target)
    System combines: user_feedback → aria_confidence_update

  Pair 17: ARIA record_decision ↔ USER demonstrate_workflow
    ARIA performs record_decision(decision, reasoning, outcome)
    USER performs demonstrate_workflow(workflow, purpose)
    System combines: user_behavior_sequence → aria_decision_record

  Pair 18: ARIA handle_user_input ↔ USER complete_task
    ARIA performs handle_user_input(action, state) [TIER 4]
    USER performs complete_task(task, context) [TIER 4]
    System combines: user_action → aria_response → user_success

  Pair 19: ARIA adapt_to_user ↔ USER learn_system
    ARIA performs adapt_to_user(behavior, state) [TIER 4]
    USER performs learn_system(domain, knowledge) [TIER 4]
    System combines: user_learning ← aria_adaptation ← user_behavior

]

TOTAL_DUAL_PAIRS: 19
Each pair is asymmetric but symmetric in role and importance

#============================================================================
# SECTION 3: EXECUTION RULES FOR USER
#============================================================================

EXECUTION_MODEL = {

  TIER_1_EXECUTION:
    When: User performs physical action (click, type, touch)
    Where: UserCapabilityLibrary.handle_input(event)
    How: Event handler captures action, interprets intent
    Ledger: NOT created (too immediate)

  TIER_2_EXECUTION:
    When: User expresses preference, confusion, or hypothesis
    Where: UserCapabilityLibrary.handle_input(event)
    How: Natural language or UI interpretation
    Ledger: NOT created (expression recorded implicitly)

  TIER_3_EXECUTION:
    When: User demonstrates mastery, helps, explores, requests, or provides feedback
    Where: UserCapabilityLibrary.handle_learning(event)
    How: Check if ledger exists → create if first event → append
    Ledger: CREATED and APPENDED TO (learning recorded)

  TIER_4_EXECUTION:
    When: User completes complex task or learns system
    Where: UserCapabilityLibrary.handle_composite(event)
    How: Compose TIER 1-3 operations, record full task/learning
    Ledger: Component ledgers created/appended as needed
}

#============================================================================
# SECTION 4: LEDGER CREATION PROTOCOL FOR USER
#============================================================================

LEDGER_CREATION = {

  FIRST_CALL_PROTOCOL:
    If ledger doesn't exist:
      1. Create ledger file with .singularity extension
      2. Write ledger header with user_id, timestamp, version
      3. Initialize append-only structure for user behavior
      4. Append first observation
      5. Cache file handle for future calls

  APPEND_PROTOCOL:
    If ledger exists (file handle cached):
      1. Append user action/observation to ledger
      2. Include: timestamp, action_type, user_intent, system_response
      3. Never rewrite or delete entries (append-only)
      4. Flush to disk after each append

  LEDGER_LOCATION:
    All TIER_3 ledgers created in: C:\Determined\src\applications\
    Naming convention: ledger_user_<operation_name>.singularity
    Example: ledger_user_mastery.singularity
}

#============================================================================
# SECTION 5: MEMORY LAYOUT AT RUNTIME
#============================================================================

USER_MEMORY_AT_STARTUP = {

  Startup Phase 1 (Initialization):
    load_library_file("ledger_user_capabilities.singularity")
    parse_symbols()
    validate_all_operations()
    Time: ~100ms

  Startup Phase 2 (TIER 1-2 Caching):
    for each TIER_1_OPERATION:
      prepare_input_handler(operation)
    for each TIER_2_OPERATION:
      prepare_interpretation_handler(operation)
    Time: ~50ms
    Memory: ~2MB (handler cache)

  Startup Phase 3 (TIER 3 Ledger Handles):
    Check which TIER_3 ledgers already exist
    Open file handles for existing ledgers
    Keep handles open for duration of session
    Time: ~50ms
    Memory: ~1MB (file handles)

  Startup Phase 4 (TIER 4 Composition Setup):
    Register composite operation sequences
    Validate composition syntax
    Prepare for execution
    Time: ~10ms

  Total Startup Time: ~200ms

  Runtime Memory Usage:
    Input handler cache (TIER 1-2): ~2MB
    File handles (TIER 3): ~1MB
    Operation cache (TIER 4): ~500KB
    Total: ~3.5MB (negligible)
}

#============================================================================
# SECTION 6: STARTUP PROCEDURE
#============================================================================

STARTUP_SEQUENCE = {

  Entry Point: UserCapabilityLibrary.__init__(ledger_dir, user_id)

  Step 1: Load Specification
    Read: ledger_user_capabilities.singularity
    Parse: All symbol definitions
    Verify: All operations properly defined
    Time: 50ms

  Step 2: Validate Specification
    Check: Every TIER 1 operation exists
    Check: Every TIER 2 operation exists
    Check: Every TIER 3 operation has ledger name
    Check: Every TIER 4 composition is valid
    Fail: If any operation invalid, raise SpecificationError
    Time: 20ms

  Step 3: Initialize TIER 1 Handlers
    For each operation in TIER_1_OPERATIONS:
      Create input event handler
      Cache in self.tier1_handlers[operation_name] = handler
    Verify: All handlers callable
    Time: 20ms

  Step 4: Initialize TIER 2 Handlers
    For each operation in TIER_2_OPERATIONS:
      Create interpretation handler
      Cache in self.tier2_handlers[operation_name] = handler
    Verify: All handlers callable
    Time: 20ms

  Step 5: Initialize TIER 3 Ledger Manager
    Create: self.tier3_ledger_manager
    Set: ledger_directory = ledger_dir, user_id = user_id
    Scan: Find existing user ledgers
    Open: File handles for existing ledgers
    Time: 30ms

  Step 6: Initialize TIER 4 Composer
    Create: self.tier4_composer
    Register: All compositions
    Verify: All compositions valid
    Time: 10ms

  Step 7: Startup Complete
    Set: self.ready = True
    Log: "User Capability Library initialized successfully"
    Return: UserCapabilityLibrary instance ready for handle_input() calls
    Total Time: ~200ms

  Error Handling:
    If any step fails:
      Log error with step number
      Raise InitializationError with details
      Do not set self.ready = True
      System cannot proceed until fixed
}

#============================================================================
# SECTION 7: USAGE EXAMPLES
#============================================================================

EXAMPLE_TRACE_1: Simple Click
  User clicks toggle button
  ├─ UserCapabilityLibrary.handle_input(click_event)
  ├─ Routes to: tier1_handlers['activate_toggle'](event)
  ├─ Handler returns: intent='toggle'
  ├─ System calls: ARIA.execute('toggle', ...)
  ├─ ARIA toggles state, returns frame
  └─ Result: Frame updated, no ledger created

EXAMPLE_TRACE_2: User Learning
  User asks "What is coherence?" (first time asking)
  ├─ UserCapabilityLibrary.handle_learning(help_request)
  ├─ Routes to: _handle_with_ledger('request_help', question)
  ├─ Check: ledger_user_help_requests.singularity exists?
  ├─ If NO: Create new ledger with header
  ├─ Append: {"timestamp": ..., "question": "What is coherence?", ...}
  ├─ Cache: File handle for next time
  ├─ System provides answer
  └─ Time: <5ms first call, <2ms subsequent calls

EXAMPLE_TRACE_3: User Demonstrates Workflow
  User: filter elections → sort by date → view in 3D (repeats 5 times)
  ├─ UserCapabilityLibrary.detect_workflow(action_sequence)
  ├─ Call 1: demonstrate_workflow(sequence) → ledger_user_workflows created
  ├─ Call 2-5: Same workflow detected, appended to ledger
  ├─ System: "Would you like a shortcut for this workflow?"
  ├─ User clicks YES
  └─ Result: Workflow learned, shortcut created

EXAMPLE_TRACE_4: Complete User Task
  User wants to "analyze elections from this month"
  ├─ UserCapabilityLibrary.handle_composite(task)
  ├─ Routes to: _execute_composition('complete_task', ...)
  ├─ Component 1: express_need("analyze_elections") → creates need ledger
  ├─ Component 2: request_help("how_to_filter_by_date") → creates help ledger
  ├─ Component 3: demonstrate_workflow([filter, sort, view]) → creates workflow ledger
  ├─ Component 4: indicate_satisfaction(0.9) → creates feedback ledger
  └─ Result: Multiple ledger entries created, user satisfied

