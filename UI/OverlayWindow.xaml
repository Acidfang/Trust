<Window x:Class="Trust.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invariant Identity Overlay" 
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Focusable="True">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" 
                          Color="Black" 
                          Direction="0" 
                          ShadowDepth="0" 
                          BlurRadius="10" 
                          Opacity="0.8"/>
    </Window.Resources>
    
    <Grid>
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Click-through mode (F9 to intercept)"
                   Visibility="Collapsed"
                   Effect="{StaticResource TextShadow}"/>
        
        <Canvas x:Name="InterceptCanvas"
                Background="Transparent"/>
        
        <!-- Timeline Inspection Panel Container -->
        <Border x:Name="TimelinePanelContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Visibility="Collapsed">
            <!-- Timeline panel will be added programmatically -->
        </Border>
        
        <!-- Quick Controls HUD -->
        <StackPanel x:Name="QuickControlsHUD"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="20"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <Border Background="#E0202020" 
                    BorderBrush="Cyan" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="F10: Timeline" 
                               Foreground="Cyan" 
                               FontSize="12" 
                               Margin="0,0,15,0"/>
                    <TextBlock Text="F11: Optimize" 
                               Foreground="Yellow" 
                               FontSize="12" 
                               Margin="0,0,15,0"/>
                    <TextBlock Text="F9: Toggle" 
                               Foreground="LightGreen" 
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
