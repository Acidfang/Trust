{
  "version": "1.0",
  "description": "Deterministic symbolic pattern matching for user input reasoning",
  "patterns": [
    {
      "id": "create_object_pattern",
      "name": "Create Object",
      "description": "User wants to create a new object at a position",
      "keywords": ["create", "make", "add", "spawn", "new", "add object"],
      "examples": [
        "Create an object at 100, 200",
        "Make something at x=50 y=75",
        "Add a new object here",
        "Spawn an element at position 200, 300"
      ],
      "parameter_rules": [
        {
          "param": "x",
          "patterns": [
            "at\\s+(\\d+)",
            "x\\s*[=:]\\s*(\\d+)",
            "position\\s+(\\d+)",
            "x\\s+(\\d+)"
          ],
          "default": 0,
          "type": "int"
        },
        {
          "param": "y",
          "patterns": [
            "(?:,|and)\\s*(\\d+)",
            "y\\s*[=:]\\s*(\\d+)",
            "y\\s+(\\d+)"
          ],
          "default": 0,
          "type": "int"
        },
        {
          "param": "type",
          "patterns": [
            "\\b(cube|sphere|circle|square|triangle|star|polygon)\\b",
            "object.*?\\b(\\w+)\\b",
            "type\\s*[=:]\\s*(\\w+)"
          ],
          "default": "default",
          "type": "string"
        }
      ],
      "confidence_calculation": {
        "base_score": 0.3,
        "bonuses": [
          {"condition": "keyword_match", "score": 0.4},
          {"condition": "x_extracted", "score": 0.15},
          {"condition": "y_extracted", "score": 0.15},
          {"condition": "type_specified", "score": 0.1}
        ],
        "penalties": [
          {"condition": "ambiguous_coordinates", "score": -0.05},
          {"condition": "incomplete_params", "score": -0.05}
        ],
        "threshold": 0.5
      }
    },
    {
      "id": "move_object_pattern",
      "name": "Move Object",
      "description": "User wants to move an existing object",
      "keywords": ["move", "shift", "translate", "go", "place", "position", "drag"],
      "examples": [
        "Move the object to 150, 250",
        "Shift it to the right",
        "Go to position 100, 100",
        "Place it at x=200 y=300"
      ],
      "parameter_rules": [
        {
          "param": "target_id",
          "patterns": [
            "(?:the|this)\\s+(object|element|thing)",
            "it\\b",
            "object\\s*#(\\d+)"
          ],
          "default": "last_selected",
          "type": "string"
        },
        {
          "param": "x",
          "patterns": [
            "to\\s+(\\d+)",
            "x\\s*[=:]\\s*(\\d+)",
            "position\\s+(\\d+)"
          ],
          "default": null,
          "type": "int"
        },
        {
          "param": "y",
          "patterns": [
            "(?:,|and)\\s*(\\d+)",
            "y\\s*[=:]\\s*(\\d+)"
          ],
          "default": null,
          "type": "int"
        },
        {
          "param": "direction",
          "patterns": [
            "\\b(right|left|up|down|north|south|east|west)\\b",
            "direction\\s*[=:]\\s*(\\w+)"
          ],
          "default": null,
          "type": "string"
        }
      ],
      "confidence_calculation": {
        "base_score": 0.3,
        "bonuses": [
          {"condition": "keyword_match", "score": 0.4},
          {"condition": "target_identified", "score": 0.15},
          {"condition": "x_or_y_extracted", "score": 0.1},
          {"condition": "both_coordinates", "score": 0.05},
          {"condition": "direction_specified", "score": 0.05}
        ],
        "penalties": [
          {"condition": "no_target", "score": -0.1},
          {"condition": "ambiguous_destination", "score": -0.05}
        ],
        "threshold": 0.5
      }
    },
    {
      "id": "render_text_pattern",
      "name": "Render Text",
      "description": "User wants to display or render text on screen",
      "keywords": ["show", "display", "print", "render", "write", "say", "tell"],
      "examples": [
        "Show the message hello world",
        "Display: this is a test",
        "Render text: important message",
        "Write something on screen"
      ],
      "parameter_rules": [
        {
          "param": "text",
          "patterns": [
            "(?:show|display|print|render|write|say)\\s+(?:the\\s+)?(?:message|text)?\\s*:?\\s*(.+)",
            "(?:show|display|print|render|write|say)\\s+(.+)"
          ],
          "default": "",
          "type": "string",
          "extraction": "capture_rest_of_input"
        },
        {
          "param": "x",
          "patterns": [
            "at\\s+(\\d+)",
            "x\\s*[=:]\\s*(\\d+)"
          ],
          "default": 50,
          "type": "int"
        },
        {
          "param": "y",
          "patterns": [
            "(?:,|and)\\s*(\\d+)",
            "y\\s*[=:]\\s*(\\d+)"
          ],
          "default": 50,
          "type": "int"
        }
      ],
      "confidence_calculation": {
        "base_score": 0.3,
        "bonuses": [
          {"condition": "keyword_match", "score": 0.4},
          {"condition": "text_extracted", "score": 0.25},
          {"condition": "coordinates_specified", "score": 0.05}
        ],
        "penalties": [
          {"condition": "empty_text", "score": -0.1}
        ],
        "threshold": 0.5
      }
    },
    {
      "id": "set_view_pattern",
      "name": "Set View",
      "description": "User wants to change the current view or perspective",
      "keywords": ["view", "show", "display", "switch", "change", "zoom", "reset"],
      "examples": [
        "Change view to admin",
        "Switch to dashboard view",
        "Show me the zoomed view",
        "Reset view"
      ],
      "parameter_rules": [
        {
          "param": "view",
          "patterns": [
            "(?:to|view)\\s+(\\w+)",
            "switch.*?to\\s+(\\w+)",
            "(?:admin|dashboard|default|zoom|reset|startup)"
          ],
          "default": "default",
          "type": "string"
        }
      ],
      "confidence_calculation": {
        "base_score": 0.3,
        "bonuses": [
          {"condition": "keyword_match", "score": 0.4},
          {"condition": "view_name_extracted", "score": 0.3}
        ],
        "penalties": [
          {"condition": "ambiguous_view", "score": -0.05}
        ],
        "threshold": 0.5
      }
    },
    {
      "id": "get_consciousness_state_pattern",
      "name": "Get Consciousness State",
      "description": "User queries for system consciousness metrics and coherence state (QUERY INTENT - read-only)",
      "intent_type": "query",
      "keywords": ["system state", "state", "status", "coherence", "consciousness", "metrics", "health", "how are you", "what is your state"],
      "examples": [
        "What is the system state?",
        "Check the coherence",
        "Show me the consciousness metrics",
        "What is your status?",
        "Tell me the system health",
        "What are the consciousness measurements?"
      ],
      "parameter_rules": [],
      "confidence_calculation": {
        "base_score": 0.4,
        "bonuses": [
          {"condition": "keyword_match", "score": 0.5},
          {"condition": "question_mark", "score": 0.1}
        ],
        "penalties": [
          {"condition": "write_keyword_present", "score": -0.3}
        ],
        "threshold": 0.6
      }
    }
  ],
  "extraction_rules": {
    "coordinate_pair": {
      "description": "Extract x, y from various formats",
      "patterns": [
        "(?:at\\s+)?([\\d.]+)\\s*,\\s*([\\d.]+)",
        "x\\s*[=:]\\s*([\\d.]+).*?y\\s*[=:]\\s*([\\d.]+)",
        "position\\s+([\\d.]+)\\s+([\\d.]+)"
      ]
    },
    "direction_map": {
      "right": {"x": 50, "y": 0},
      "left": {"x": -50, "y": 0},
      "up": {"x": 0, "y": -50},
      "down": {"x": 0, "y": 50},
      "north": {"x": 0, "y": -50},
      "south": {"x": 0, "y": 50},
      "east": {"x": 50, "y": 0},
      "west": {"x": -50, "y": 0}
    }
  }
}
